{
  "name": "HotwireCity",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "Loading": {
        "$path": "src/first"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMaxZoomDistance": 90,
        "CharacterWalkSpeed": 18,
        "CharacterJumpPower": 50,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 196.2,
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -200,
        "SignalBehavior": "Deferred"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Brightness": 2.5,
        "ClockTime": 16.5,
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {}
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 3
      }
    },
    "Teams": {
      "$className": "Teams"
    }
  }
}