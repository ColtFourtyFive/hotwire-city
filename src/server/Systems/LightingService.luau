local cycleStart = os.clock() - LightingService.timeForHour(Look.Cycle.startHour)
local night = LightingService.nightFactorAt(Look.Cycle.startHour) >= Look.Night.lightsOn
local nightFactor = LightingService.nightFactorAt(Look.Cycle.startHour)
local wet = false
local glowVersion = 0
local currentSky: string? = nil
local skyYawCurrent: number? = nil
local skyYawWritten: number? = nil
local connected = false

type WindowState = { params: WindowParams, color: Color3, material: Enum.Material, on: boolean? }
local windows: { [BasePart]: WindowState } = {}
local windowNf: number? = nil
local windowVersion = 0

local sky: Sky? = nil
local atmosphere: Atmosphere? = nil
local bloom: BloomEffect? = nil
local color: ColorCorrectionEffect? = nil
local sunRays: SunRaysEffect? = nil
local clouds: Clouds? = nil

local COLOR_EPS = 1.5 / 255
local written: { [string]: any } = {} -- last value written per "Object.Property" (see LightingService._changed)

local function rgb(c: RGB): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function write(inst: Instance?, key: string, prop: string, value: any, eps: number)
	if not inst or not LightingService._changed(written[key], value, eps) then
		return
	end
	written[key] = value
	local target: any = inst
	target[prop] = value
end

local function writeAttr(inst: Instance, name: string, value: number, eps: number): boolean
	local key = "@" .. name
	if not LightingService._changed(written[key], value, eps) then
		return false
	end
	written[key] = value
	inst:SetAttribute(name, value)
	return true
end

-- Forget every cached write and the sky state: the next apply writes everything (new / re-adopted instances).
local function resetWriteCache()
	table.clear(written)
	currentSky = nil
	skyYawCurrent = nil
	skyYawWritten = nil
end

-- Test hook: engine sun direction (Lighting:GetSunDirection on a live server; nil headless).
function LightingService._sunDirection(): Vector3?
	local ok, dir = pcall(function()
		return (Lighting :: any):GetSunDirection()
	end)
	if ok and typeof(dir) == "Vector3" then
		return dir
	end
	return nil
end

-- Test hook: Terrain:SetMaterialColor (not implemented headless).
function LightingService._setTerrainColor(terrain: Terrain, material: Enum.Material, c: Color3)
	terrain:SetMaterialColor(material, c)
end

-- Test hook: MaterialService:SetBaseMaterialOverride(Asphalt, name) (wet streets).
function LightingService._setAsphaltOverride(name: string)
	local MaterialService = game:GetService("MaterialService")
	if MaterialService:FindFirstChild(name) then
		MaterialService:SetBaseMaterialOverride(Enum.Material.Asphalt, name)
	end
end

local function tuning(): Look.Tuning
	local override = Workspace:GetAttribute("AtmosphereOffsetOverride")
	if typeof(override) == "number" then
		return { offset = override, hazeScale = Look.Tuning.hazeScale, densityScale = Look.Tuning.densityScale }
	end
	return Look.Tuning
end

local function cloudsOverride(): number
	local v = Workspace:GetAttribute("CloudsOverride")
	return if typeof(v) == "number" then math.max(v, 0) else 1
end

-- The game hour now (Workspace "TimeOfDayLock" holds it).
local function currentHour(): number
	local lock = Workspace:GetAttribute("TimeOfDayLock")
	if typeof(lock) == "number" then
		cycleStart = os.clock() - LightingService.timeForHour(lock)
		return lock % 24
	end
	return LightingService.hourAt(os.clock() - cycleStart)
end

-- The engine ClockTime for a game hour (Workspace "EngineClockOverride" pins it for labs).
local function engineClock(hour: number): number
	local override = Workspace:GetAttribute("EngineClockOverride")
	if typeof(override) == "number" then
		return override % 24
	end
	return LightingService.engineClockAt(hour)
end

---------------------------------------------------------------------------------------------------------------------
-- One of each Lighting child (dedupe)
---------------------------------------------------------------------------------------------------------------------

type ManagedSpec = { className: string, name: string }
local MANAGED: { ManagedSpec } = {
	{ className = "Sky", name = "Sky" },
	{ className = "Atmosphere", name = "Atmosphere" },
	{ className = "BloomEffect", name = "Bloom" },
	{ className = "ColorCorrectionEffect", name = "ColorCorrection" },
	{ className = "SunRaysEffect", name = "SunRays" },
}
LightingService.MANAGED = MANAGED
local owned: { [string]: Instance } = {}

-- Keeps exactly one `className` child of Lighting and returns it with the number of duplicates destroyed. The keeper
-- is the one this service already owns, else one it marked owned earlier (OWNED_ATTRIBUTE), else the place file's
-- (by name), else the first; every other one of that class is destroyed (Roblox renders one Sky / Atmosphere, and
-- post effects stack). Creates one if there is none.
local function adoptOne(className: string, name: string): (Instance, number)
	local keep: Instance? = owned[className]
	if keep and keep.Parent ~= Lighting then
		keep = nil
	end
	local children = Lighting:GetChildren()
	if keep == nil then
		for _, c in children do
			if c:IsA(className) and c:GetAttribute(LightingService.OWNED_ATTRIBUTE) == true then
				keep = c
				break
			end
		end
	end
	if keep == nil then
		local named = Lighting:FindFirstChild(name)
		if named and named:IsA(className) then
			keep = named
		end
	end
	local destroyed = 0
	for _, c in children do
		if c:IsA(className) then
			if keep == nil then
				keep = c
			elseif c ~= keep then
				c:Destroy()
				destroyed += 1
			end
		end
	end
	local inst: Instance
	if keep then
		inst = keep
	else
		inst = Instance.new(className :: any)
		inst.Name = name
		inst.Parent = Lighting
	end
	inst:SetAttribute(LightingService.OWNED_ATTRIBUTE, true)
	return inst, destroyed
end

-- Adopts one of each managed class and (re)applies their static setup. When a kept instance changed identity, the
-- write cache is reset so the next apply configures it in full.
local function adoptAll(): number
	local destroyed = 0
	local changed = false
	for _, m in MANAGED do
		local inst, n = adoptOne(m.className, m.name)
		destroyed += n
		if owned[m.className] ~= inst then
			owned[m.className] = inst
			changed = true
		end
	end
	local s = owned.Sky :: Sky
	s.SunAngularSize = Look.SkyStyle.sunAngularSize
	s.MoonAngularSize = Look.SkyStyle.moonAngularSize
	sky = s
	atmosphere = owned.Atmosphere :: Atmosphere
	local b = owned.BloomEffect :: BloomEffect
	local cc = owned.ColorCorrectionEffect :: ColorCorrectionEffect
	local sr = owned.SunRaysEffect :: SunRaysEffect
	b.Enabled = true -- a leftover duplicate may have been the enabled one
	cc.Enabled = true
	sr.Enabled = true
	bloom, color, sunRays = b, cc, sr
	if changed then
		resetWriteCache()
	end
	return destroyed
end

-- Exactly one Sky / Atmosphere / BloomEffect / ColorCorrectionEffect / SunRaysEffect under Lighting, keeping the ones
-- this service owns and configures. Returns how many duplicates it destroyed. Runs at init and (deferred) whenever
-- one of those classes is added to Lighting later.
function LightingService.dedupe(): number
	local n = adoptAll()
	if n > 0 then
		warn(
			("[LightingService] destroyed %d duplicate Lighting effect(s) (Team Create / Rojo live-sync leftovers)"):format(
				n
			)
		)
	end
	return n
end

-- Lighting.ChildAdded handler (deferred); a test hook too (headless Lighting has no ChildAdded).
function LightingService._onLightingChildAdded(child: Instance)
	for _, m in MANAGED do
		if child:IsA(m.className) then
			LightingService.dedupe()
			return
		end
	end
end

