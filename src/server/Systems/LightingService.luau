--!strict
-- LightingService v2: the GTA time of day (docs/v2/PLAN.md decision 3, research/lighting_lab.md rounds 1 + 2,
-- Config/Look).
--
-- * The place file carries what scripts cannot set: LightingStyle = Realistic, PrioritizeLightingQuality, the
--   MaterialVariants and the default Sky (default.project.json, generated by tools/look/gen_project.py). This service
--   animates the time of day and applies the runtime-settable look. Lighting.Technology is deprecated +
--   RobloxScript-only and is never written.
-- * Clock: a 24-minute GAME day (Look.Cycle), night fast / dawn + dusk slow. The game hour is the truth for every
--   other system: Workspace "TimeOfDay", NightFactor, street lights, lit windows, the presets, the sky schedule.
-- * Engine clock (lab round 2): Lighting.ClockTime is NOT the game hour. The engine blacks out the skybox once its sun
--   is well below the horizon (a pure black night sky at 22.5, a near-black purple blue hour at 18.7), so
--   engineClockAt maps the game hour onto a ClockTime that equals it by day, eases into a hold just past the evening
--   horizon (sun -3 deg), jumps ONCE at full night to a hold just before the morning horizon and eases back onto the
--   game clock after dawn (Look.EngineClock). The night is faked by the presets; the night HDRI stays visible.
--   Written at 4 Hz, and only when it moves (the holds cost nothing).
-- * Sun: Roblox's sun path was measured in the real engine (Look.Sun; sunrise 06:00, sunset 18:00 at every latitude,
--   79.5 deg culmination at latitude 34). sunDirectionAt reproduces it for an ENGINE ClockTime; the engine's
--   GetSunDirection is used live.
-- * Look: keyframed presets over the game hour (night, blue hour, golden morning, day, golden evening, blue hour)
--   smoothstepped every 1 s. Atmosphere capped at Density 0.30 / Haze 1.2 (lab round 1); the sunlit presets' Offset
--   0.25 / Haze 0.8 are locked (lab round 2, Look.AtmosphereLock). Writes are cheap: a property is only written when it
--   moved past a per-property epsilon since the last write (plateaus cost nothing).
-- * Sky: HDRI skies (Look.Skies) swapped on Look.SkySchedule, four times a day, always with the engine sun below the
--   horizon and under a short exposure dip (Look.SkySwap); there is no day <-> golden swap (it cannot be hidden; see
--   Look.SkySchedule). Per-sky stars, sun/moon discs and volumetric cloud share. A following sky's glow is kept on the
--   engine sun at most Look.SkyStyle.maxYawRate deg/s (yawSign +1, engine-verified); the night sky parks its city
--   glow inland.
-- * One of each: exactly one Sky, Atmosphere, BloomEffect, ColorCorrectionEffect and SunRaysEffect under Lighting
--   (dedupe: at init, and again whenever one of those is added). Team Create + Rojo live-sync leaves duplicates
--   (Rojo cannot swap the Lighting service, job 0007); the instance this service owns (attribute "HCLookOwned") is
--   kept and configured, the extras are destroyed.
-- * Lit windows: tag "LitWindow" (and v1 glass NightGlow parts) light up over dusk, a deterministic share of them,
--   warm and cool, each at its own NightFactor, DIM (lab round 2 S6): small cells as faint Neon, facade-sized parts
--   never Neon (Look.Windows). windowEmissiveColor is the building package's helper (Look.Night.windowEmissive).
-- * Terrain: water colour/reflectance (Look.Water) and the terrain material colours that match the MaterialVariant
--   colour maps (Look.TerrainColors), applied after MapBuilder. Optional wet streets at night (Look.WetStreets).
-- * Published state for other systems: Workspace attributes "NightFactor" (0 day .. 1 night, smooth; lit windows,
--   street lights) and "TimeOfDay" (GAME hours, 0..24); Lighting attribute "Sky". Workspace attributes
--   "TimeOfDayLock" (game hours), "EngineClockOverride" (engine ClockTime), "AtmosphereOffsetOverride" and
--   "CloudsOverride" are live overrides for screenshots / lab rounds.
-- * v1 contract kept: Lighting attribute "IsNight", NightChanged(isNight), tags "StreetLight" (lights on at night)
--   and "NightGlow" (DayColor/DayMaterial <-> NightColor/NightMaterial swaps), switched at NightFactor ~0.5.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Look = require(ReplicatedStorage.Shared.Config.Look)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

type Preset = Look.Preset
type RGB = Look.RGB
type WindowParams = Look.WindowParams

local LightingService = {}

LightingService.TAG_STREET_LIGHT = "StreetLight"
LightingService.TAG_NIGHT_GLOW = "NightGlow"
LightingService.TAG_LIT_WINDOW = Look.Windows.tag
LightingService.GLOW_BATCH = 150 -- NightGlow parts swapped per frame
LightingService.CYCLE_SECONDS = Look.Cycle.lengthSeconds
LightingService.START_HOUR = Look.Cycle.startHour
LightingService.ENV_INTERVAL = Look.Cycle.envInterval
LightingService.CLOCK_INTERVAL = Look.Cycle.clockInterval
LightingService.OWNED_ATTRIBUTE = "HCLookOwned" -- marks the Lighting children this service keeps (dedupe)

LightingService.NightChanged = Signal.new() -- (isNight: boolean)

---------------------------------------------------------------------------------------------------------------------
-- Pure helpers (unit-tested in tests/spec/look.spec.luau)
---------------------------------------------------------------------------------------------------------------------

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function smoothstep(e0: number, e1: number, x: number): number
	local t = clamp01((x - e0) / (e1 - e0))
	return t * t * (3 - 2 * t)
end

-- Clock segments: the bands' relative speeds normalised so a whole day lasts Look.Cycle.lengthSeconds.
type Segment = { from: number, to: number, t0: number, t1: number }
local SEGMENTS: { Segment } = {}
do
	local weighted = 0
	for _, b in Look.Cycle.bands do
		weighted += (b.to - b.from) * b.weight
	end
	local perUnit = Look.Cycle.lengthSeconds / weighted
	local t = 0
	for _, b in Look.Cycle.bands do
		local dur = (b.to - b.from) * b.weight * perUnit
		table.insert(SEGMENTS, { from = b.from, to = b.to, t0 = t, t1 = t + dur })
		t += dur
	end
end
LightingService.SEGMENTS = SEGMENTS

-- Game hour (0..24) at `t` seconds into the cycle (t = 0 is midnight).
function LightingService.hourAt(t: number): number
	local tt = t % Look.Cycle.lengthSeconds
	for _, s in SEGMENTS do
		if tt < s.t1 then
			return s.from + (s.to - s.from) * ((tt - s.t0) / (s.t1 - s.t0))
		end
	end
	return 0
end

-- Cycle time (seconds) at which the game clock shows `hour`.
function LightingService.timeForHour(hour: number): number
	local h = hour % 24
	for _, s in SEGMENTS do
		if h < s.to then
			return s.t0 + (s.t1 - s.t0) * ((h - s.from) / (s.to - s.from))
		end
	end
	return 0
end

-- The engine Lighting.ClockTime for a GAME hour (Look.EngineClock, lab round 2). By day it is the game hour. From
-- eveningHold - ease / 2 it eases out (slope 1 -> 0, C1, quadratic) into eveningHold over `ease` game hours and holds
-- it; at jumpHour it jumps to morningHold (a single write: the engine never renders the deep-night sun in between)
-- and holds that until it eases back in (slope 0 -> 1) to rejoin the game hour at morningHold + ease / 2. The engine
-- clock never runs faster than the game clock. Pure.
function LightingService.engineClockAt(hour: number): number
	local E = Look.EngineClock
	local h = hour % 24
	local ease = E.ease
	local eve0 = E.eveningHold - ease / 2 -- the engine sun starts slowing here ...
	local eve1 = eve0 + ease -- ... and stops at eveningHold here
	local morn1 = E.morningHold + ease / 2 -- back on the game clock here ...
	local morn0 = morn1 - ease -- ... after leaving morningHold here
	if h >= morn1 and h <= eve0 then
		return h
	elseif h > eve0 and h < eve1 then
		local d = h - eve0
		return eve0 + d - d * d / (2 * ease)
	elseif h > morn0 and h < morn1 then
		local u = morn1 - h
		return morn1 - u + u * u / (2 * ease)
	end
	-- the night hold: evening hold from eve1 up to jumpHour, morning hold from jumpHour to morn0
	if (h - eve1) % 24 < (E.jumpHour - eve1) % 24 then
		return E.eveningHold
	end
	return E.morningHold
end

-- Recursively interpolates two preset trees (numbers and {r,g,b} arrays).
local function lerpTree(a: any, b: any, t: number): any
	if type(a) == "number" then
		return a + (b - a) * t
	end
	local out = {}
	for k, v in a do
		out[k] = lerpTree(v, b[k], t)
	end
	return out
end

-- The engine sun direction (unit vector components) at an ENGINE ClockTime, as measured in the real engine (Look.Sun):
-- a circle about the horizontal Z axis, tilted by phi = latitude - 23.5 deg; theta = 15 deg per hour from 06:00.
-- For a game hour, pass engineClockAt(hour).
function LightingService.sunDirectionAt(hour: number, latitude: number?): (number, number, number)
	local phi = math.rad((latitude or Look.Sun.latitude) - Look.Sun.tiltOffset)
	local theta = math.rad(15 * ((hour % 24) - 6))
	local c = math.cos(phi)
	return c * math.cos(theta), c * math.sin(theta), math.sin(phi)
end

-- Engine sun elevation in degrees at an ENGINE ClockTime (negative = below the horizon).
function LightingService.sunElevationAt(hour: number, latitude: number?): number
	local _, y, _ = LightingService.sunDirectionAt(hour, latitude)
	return math.deg(math.asin(math.clamp(y, -1, 1)))
end

-- ExposureCompensation dip (EV, >= 0) that masks each sky swap and the engine-clock jump: a gaussian of
-- Look.SkySwap.exposureDip over +-Look.SkySwap.width game hours, circular over midnight.
function LightingService.swapDipAt(hour: number): number
	local h = hour % 24
	local S = Look.SkySwap
	local function dip(at: number): number
		local d = math.abs(h - at % 24)
		d = math.min(d, 24 - d)
		return S.exposureDip * math.exp(-(d / S.width) ^ 2)
	end
	local best = dip(Look.EngineClock.jumpHour)
	for _, e in Look.SkySchedule do
		best = math.max(best, dip(e.hour))
	end
	return best
end

-- Interpolated look for a game hour (0..24): keyframes smoothstepped, then tuning, the lab caps and the swap dip.
function LightingService.lookAt(hour: number, tuning: Look.Tuning?): Preset
	local h = hour % 24
	local keys = Look.Keys
	local a, b = keys[1], keys[#keys]
	for i = 1, #keys - 1 do
		if h >= keys[i].hour and h <= keys[i + 1].hour then
			a, b = keys[i], keys[i + 1]
			break
		end
	end
	local span = b.hour - a.hour
	local t = if span > 0 then (h - a.hour) / span else 0
	t = t * t * (3 - 2 * t)
	local look: Preset = lerpTree(Look.Presets[a.preset], Look.Presets[b.preset], t)
	local tune: Look.Tuning = tuning or Look.Tuning
	local atmo = look.atmosphere
	if tune.offset ~= nil then
		atmo.offset = tune.offset
	end
	atmo.density = math.min(atmo.density * tune.densityScale, Look.Caps.densityMax)
	atmo.haze = math.min(atmo.haze * tune.hazeScale, Look.Caps.hazeMax)
	look.exposure -= LightingService.swapDipAt(h)
	return look
end

-- 0 = day .. 1 = night (GAME hour), smooth ramps at dusk and dawn.
function LightingService.nightFactorAt(hour: number): number
	local h = hour % 24
	local n = Look.Night
	if h >= n.duskStart then
		return smoothstep(n.duskStart, n.duskFull, h)
	elseif h < n.dawnFull then
		return 1
	end
	return 1 - smoothstep(n.dawnFull, n.dawnEnd, h)
end

-- Which sky is up at a game hour (the last schedule entry at or before it; wraps over midnight).
function LightingService.skyAt(hour: number): string
	local h = hour % 24
	local sched = Look.SkySchedule
	local name = sched[#sched].sky
	for _, e in sched do
		if h >= e.hour then
			name = e.sky
		end
	end
	return name
end

-- Game hours until the next sky swap from `hour`, and the sky it swaps to.
function LightingService.nextSkySwap(hour: number): (number, string)
	local h = hour % 24
	local bestDt, bestSky = math.huge, Look.SkySchedule[1].sky
	for _, e in Look.SkySchedule do
		local dt = (e.hour - h) % 24
		if dt > 0 and dt < bestDt then
			bestDt, bestSky = dt, e.sky
		end
	end
	return bestDt, bestSky
end

local function skyClouds(name: string): number
	local def = Look.Skies[name]
	return if def then def.clouds else 1
end

-- Share of the preset's volumetric cloud cover while a sky is up (Look.Skies[*].clouds), blended smoothly across
-- +-Look.SkySwap.width hours around each swap so clouds fade instead of popping.
function LightingService.cloudScaleAt(hour: number): number
	local h = hour % 24
	local w = Look.SkySwap.width
	local sched = Look.SkySchedule
	for i, e in sched do
		local d = h - e.hour
		if d > 12 then
			d -= 24
		elseif d < -12 then
			d += 24
		end
		if math.abs(d) < w then
			local prev = sched[if i == 1 then #sched else i - 1].sky
			local t = smoothstep(-w, w, d)
			return skyClouds(prev) + (skyClouds(e.sky) - skyClouds(prev)) * t
		end
	end
	return skyClouds(LightingService.skyAt(h))
end

-- Azimuth in degrees of a direction: 0 = -Z, 90 = +X (the convention tools/look/hdri_to_skybox.py records).
function LightingService.azimuthOf(x: number, z: number): number
	return math.deg(math.atan2(x, -z))
end

local function wrapDeg(d: number): number
	local w = (d + 180) % 360 - 180
	return if w == -180 then 180 else w
end
LightingService.wrapDeg = wrapDeg

-- SkyboxOrientation.Y that turns a sky feature at azimuth `skyAzimuth` to azimuth `targetAzimuth` (degrees).
function LightingService.yawToward(skyAzimuth: number, targetAzimuth: number, sign: number?): number
	return wrapDeg((sign or Look.SkyStyle.yawSign) * (skyAzimuth - targetAzimuth))
end

-- SkyboxOrientation.Y that puts a sky's glow (at azimuth `skyAzimuth`, degrees) under the engine sun direction
-- (x, z = horizontal components). nil when the sun is (nearly) overhead and the azimuth is meaningless.
function LightingService.skyYaw(skyAzimuth: number, sunX: number, sunZ: number, sign: number?): number?
	if math.sqrt(sunX * sunX + sunZ * sunZ) < 0.05 then
		return nil
	end
	return LightingService.yawToward(skyAzimuth, LightingService.azimuthOf(sunX, sunZ), sign)
end

-- Moves an angle toward a target by at most maxStep degrees, the short way round.
function LightingService.stepYaw(current: number, target: number, maxStep: number): number
	local d = wrapDeg(target - current)
	if math.abs(d) <= maxStep then
		return wrapDeg(target)
	end
	return wrapDeg(current + (if d > 0 then maxStep else -maxStep))
end

-- 32-bit integer helpers for the window hash (exact in doubles: every product stays below 2^53).
local TWO32 = 4294967296
local function mul32(a: number, b: number): number
	local bl = b % 65536
	local bh = (b - bl) / 65536
	return (a * bl + ((a * bh) % 65536) * 65536) % TWO32
end
local function fmix32(h: number): number
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = mul32(h, 0x85EBCA6B)
	h = bit32.bxor(h, bit32.rshift(h, 13))
	h = mul32(h, 0xC2B2AE35)
	return bit32.bxor(h, bit32.rshift(h, 16))
end

-- Deterministic per-window look from its position (studs; rounded to half a stud so tiny float noise does not matter):
-- whether it lights at all, warm or cool, its brightness level, and the NightFactor it switches at (Look.Windows).
function LightingService.windowParams(x: number, y: number, z: number): WindowParams
	local function q(v: number): number
		return math.floor(v * 2 + 0.5) % TWO32
	end
	local h = fmix32(bit32.bxor(mul32(q(x), 0x9E3779B1), mul32(q(y), 0x85EBCA77), mul32(q(z), 0xC2B2AE3D)))
	local function u(seed: number): number
		return fmix32(bit32.bxor(h, seed)) / TWO32
	end
	local W = Look.Windows
	local level = u(0x1B56C4E9)
	return {
		lit = u(0x68E31DA4) < W.share,
		warm = u(0xB5297A4D) < W.warmShare,
		level = level,
		brightness = W.brightness[1] + (W.brightness[2] - W.brightness[1]) * level,
		threshold = W.onBand[1] + (W.onBand[2] - W.onBand[1]) * u(0x2F3A9C71),
	}
end

-- The building package's lit-window helper (Look.Night.windowEmissive): whether the window CELL at (x, y, z) is one
-- of the lit ones (the same deterministic pick and share as the LitWindow system) and its colour at NightFactor `nf`.
-- Unlit cells keep `dayColor`; a lit one fades from `dayColor` (default black) to warm / cool x the material's factor
-- over windowEmissive.fadeIn. `material` (default windowEmissive.material) picks the factor range: Neon gets the dim
-- neonFactor (under the night Bloom threshold), anything else the brighter factor (not self-lit: it cannot bloom).
-- Pure; call it again as NightFactor moves (or quantise NightFactor) to fade the cells in.
function LightingService.windowEmissiveColor(
	x: number,
	y: number,
	z: number,
	nf: number,
	dayColor: Color3?,
	material: string?
): (boolean, Color3)
	local E = Look.Night.windowEmissive
	local day = dayColor or Color3.new(0, 0, 0)
	local p = LightingService.windowParams(x, y, z)
	if not p.lit then
		return false, day
	end
	local range = if (material or E.material) == "Neon" then E.neonFactor else E.factor
	local k = range[1] + (range[2] - range[1]) * p.level
	local base = if p.warm then E.warm else E.cool
	local lit = Color3.new(base[1] / 255 * k, base[2] / 255 * k, base[3] / 255 * k)
	return true, day:Lerp(lit, smoothstep(E.fadeIn[1], E.fadeIn[2], nf))
end

-- Area of a part's largest face (studs^2): a window cell vs a facade band / tower (Look.Windows.maxNeonArea).
function LightingService.largestFaceArea(size: Vector3): number
	return math.max(size.X * size.Y, size.Y * size.Z, size.X * size.Z)
end

-- Write-skip test: has `value` moved far enough from the last written `last` (nil = never written)? Colors compare
-- per channel. Pure, unit-tested.
function LightingService._changed(last: any, value: any, eps: number): boolean
	if last == nil or typeof(last) ~= typeof(value) then
		return true
	end
	if typeof(value) == "Color3" then
		return math.max(math.abs(last.R - value.R), math.abs(last.G - value.G), math.abs(last.B - value.B)) >= eps
	end
	if typeof(value) == "Vector3" then
		return (last - value).Magnitude >= eps
	end
	if typeof(value) == "number" then
		return math.abs(last - value) >= eps
	end
	return last ~= value
end

