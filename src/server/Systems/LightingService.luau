--!strict
-- LightingService v2: the GTA time of day (docs/v2/PLAN.md decision 3, research/lighting_lab.md, Config/Look).
--
-- * The place file carries what scripts cannot set: LightingStyle = Realistic, PrioritizeLightingQuality, the
--   MaterialVariants and the default Sky (default.project.json, generated by tools/look/gen_project.py). This service
--   only animates the time of day. Lighting.Technology is deprecated + RobloxScript-only and is never written.
-- * Clock: a 24-minute day (Look.Cycle), night fast / dawn + dusk slow. ClockTime is written at 1 Hz.
-- * Look: keyframed presets (night, blue hour, golden morning, day, golden evening, blue hour) smoothstepped every
--   2 s; Atmosphere capped at Density 0.30 / Haze 1.2 (lab round 1), Offset tunable (Look.Tuning / Workspace attribute
--   "AtmosphereOffsetOverride"). Writes are cheap: a property is only written when it moved past a per-property
--   epsilon since the last write (plateaus cost nothing).
-- * Sky: HDRI skies (Look.Skies) swapped on Look.SkySchedule at moments the change is hard to see (sun below the
--   horizon, or under a short haze bump); SkyboxOrientation.Y keeps the sky's sun glow on the engine sun.
-- * Published state for other systems: Workspace attributes "NightFactor" (0 day .. 1 night, smooth; lit windows,
--   street lights) and "TimeOfDay" (hours, 0..24). Workspace attribute "TimeOfDayLock" (hours) holds the clock for
--   screenshots and tests.
-- * v1 contract kept: Lighting attribute "IsNight", NightChanged(isNight), tags "StreetLight" (lights on at night)
--   and "NightGlow" (DayColor/DayMaterial <-> NightColor/NightMaterial swaps), switched at NightFactor ~0.5.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Look = require(ReplicatedStorage.Shared.Config.Look)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

type Preset = Look.Preset
type RGB = Look.RGB

local LightingService = {}

LightingService.TAG_STREET_LIGHT = "StreetLight"
LightingService.TAG_NIGHT_GLOW = "NightGlow"
LightingService.GLOW_BATCH = 150 -- NightGlow parts swapped per frame
LightingService.CYCLE_SECONDS = Look.Cycle.lengthSeconds
LightingService.START_HOUR = Look.Cycle.startHour
LightingService.ENV_INTERVAL = Look.Cycle.envInterval
LightingService.CLOCK_INTERVAL = Look.Cycle.clockInterval

LightingService.NightChanged = Signal.new() -- (isNight: boolean)

---------------------------------------------------------------------------------------------------------------------
-- Pure helpers (unit-tested in tests/spec/look.spec.luau)
---------------------------------------------------------------------------------------------------------------------

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function smoothstep(e0: number, e1: number, x: number): number
	local t = clamp01((x - e0) / (e1 - e0))
	return t * t * (3 - 2 * t)
end

-- Clock segments: the bands' relative speeds normalised so a whole day lasts Look.Cycle.lengthSeconds.
type Segment = { from: number, to: number, t0: number, t1: number }
local SEGMENTS: { Segment } = {}
do
	local weighted = 0
	for _, b in Look.Cycle.bands do
		weighted += (b.to - b.from) * b.weight
	end
	local perUnit = Look.Cycle.lengthSeconds / weighted
	local t = 0
	for _, b in Look.Cycle.bands do
		local dur = (b.to - b.from) * b.weight * perUnit
		table.insert(SEGMENTS, { from = b.from, to = b.to, t0 = t, t1 = t + dur })
		t += dur
	end
end
LightingService.SEGMENTS = SEGMENTS

-- ClockTime (0..24) at `t` seconds into the cycle (t = 0 is midnight).
function LightingService.hourAt(t: number): number
	local tt = t % Look.Cycle.lengthSeconds
	for _, s in SEGMENTS do
		if tt < s.t1 then
			return s.from + (s.to - s.from) * ((tt - s.t0) / (s.t1 - s.t0))
		end
	end
	return 0
end

-- Cycle time (seconds) at which the clock shows `hour`.
function LightingService.timeForHour(hour: number): number
	local h = hour % 24
	for _, s in SEGMENTS do
		if h < s.to then
			return s.t0 + (s.t1 - s.t0) * ((h - s.from) / (s.to - s.from))
		end
	end
	return 0
end

-- Recursively interpolates two preset trees (numbers and {r,g,b} arrays).
local function lerpTree(a: any, b: any, t: number): any
	if type(a) == "number" then
		return a + (b - a) * t
	end
	local out = {}
	for k, v in a do
		out[k] = lerpTree(v, b[k], t)
	end
	return out
end

-- Extra Atmosphere.Haze around each sky swap (gaussian in game hours, circular over midnight).
function LightingService.swapHazeAt(hour: number): number
	local h = hour % 24
	local best = 0
	for _, e in Look.SkySchedule do
		local d = math.abs(h - e.hour)
		d = math.min(d, 24 - d)
		best = math.max(best, Look.SkySwap.hazeBoost * math.exp(-(d / Look.SkySwap.width) ^ 2))
	end
	return best
end

-- Interpolated look for an hour (0..24): keyframes smoothstepped, then tuning, sky-swap haze and the lab caps.
function LightingService.lookAt(hour: number, tuning: Look.Tuning?): Preset
	local h = hour % 24
	local keys = Look.Keys
	local a, b = keys[1], keys[#keys]
	for i = 1, #keys - 1 do
		if h >= keys[i].hour and h <= keys[i + 1].hour then
			a, b = keys[i], keys[i + 1]
			break
		end
	end
	local span = b.hour - a.hour
	local t = if span > 0 then (h - a.hour) / span else 0
	t = t * t * (3 - 2 * t)
	local look: Preset = lerpTree(Look.Presets[a.preset], Look.Presets[b.preset], t)
	local tune: Look.Tuning = tuning or Look.Tuning
	local atmo = look.atmosphere
	if tune.offset ~= nil then
		atmo.offset = tune.offset
	end
	atmo.density = math.min(atmo.density * tune.densityScale, Look.Caps.densityMax)
	atmo.haze = math.min(atmo.haze * tune.hazeScale + LightingService.swapHazeAt(h), Look.Caps.hazeMax)
	return look
end

-- 0 = day .. 1 = night, smooth ramps at dusk and dawn.
function LightingService.nightFactorAt(hour: number): number
	local h = hour % 24
	local n = Look.Night
	if h >= n.duskStart then
		return smoothstep(n.duskStart, n.duskFull, h)
	elseif h < n.dawnFull then
		return 1
	end
	return 1 - smoothstep(n.dawnFull, n.dawnEnd, h)
end

-- Which sky is up at an hour (the last schedule entry at or before it; wraps over midnight).
function LightingService.skyAt(hour: number): string
	local h = hour % 24
	local sched = Look.SkySchedule
	local name = sched[#sched].sky
	for _, e in sched do
		if h >= e.hour then
			name = e.sky
		end
	end
	return name
end

-- Hours until the next sky swap from `hour`, and the sky it swaps to.
function LightingService.nextSkySwap(hour: number): (number, string)
	local h = hour % 24
	local bestDt, bestSky = math.huge, Look.SkySchedule[1].sky
	for _, e in Look.SkySchedule do
		local dt = (e.hour - h) % 24
		if dt > 0 and dt < bestDt then
			bestDt, bestSky = dt, e.sky
		end
	end
	return bestDt, bestSky
end

-- Azimuth in degrees of a direction: 0 = -Z, 90 = +X (the convention tools/look/hdri_to_skybox.py records).
function LightingService.azimuthOf(x: number, z: number): number
	return math.deg(math.atan2(x, -z))
end

local function wrapDeg(d: number): number
	local w = (d + 180) % 360 - 180
	return if w == -180 then 180 else w
end
LightingService.wrapDeg = wrapDeg

-- SkyboxOrientation.Y that puts a sky's glow (at azimuth `skyAzimuth`, degrees) under the engine sun direction
-- (x, z = horizontal components). nil when the sun is (nearly) overhead and the azimuth is meaningless.
function LightingService.skyYaw(skyAzimuth: number, sunX: number, sunZ: number, sign: number?): number?
	if math.sqrt(sunX * sunX + sunZ * sunZ) < 0.05 then
		return nil
	end
	local engineAz = LightingService.azimuthOf(sunX, sunZ)
	return wrapDeg((sign or Look.SkyStyle.yawSign) * (skyAzimuth - engineAz))
end

-- Write-skip test: has `value` moved far enough from the last written `last` (nil = never written)? Colors compare
-- per channel. Pure, unit-tested.
function LightingService._changed(last: any, value: any, eps: number): boolean
	if last == nil or typeof(last) ~= typeof(value) then
		return true
	end
	if typeof(value) == "Color3" then
		return math.max(math.abs(last.R - value.R), math.abs(last.G - value.G), math.abs(last.B - value.B)) >= eps
	end
	if typeof(value) == "Vector3" then
		return (last - value).Magnitude >= eps
	end
	if typeof(value) == "number" then
		return math.abs(last - value) >= eps
	end
	return last ~= value
end

---------------------------------------------------------------------------------------------------------------------
-- State
---------------------------------------------------------------------------------------------------------------------

local cycleStart = os.clock() - LightingService.timeForHour(Look.Cycle.startHour)
local night = LightingService.nightFactorAt(Look.Cycle.startHour) >= Look.Night.lightsOn
local nightFactor = LightingService.nightFactorAt(Look.Cycle.startHour)
local glowVersion = 0
local currentSky: string? = nil
local skyYawWritten: number? = nil

local sky: Sky? = nil
local atmosphere: Atmosphere? = nil
local bloom: BloomEffect? = nil
local color: ColorCorrectionEffect? = nil
local sunRays: SunRaysEffect? = nil
local clouds: Clouds? = nil

local COLOR_EPS = 1.5 / 255
local written: { [string]: any } = {} -- last value written per "Object.Property" (see LightingService._changed)

local function rgb(c: RGB): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function write(inst: Instance?, key: string, prop: string, value: any, eps: number)
	if not inst or not LightingService._changed(written[key], value, eps) then
		return
	end
	written[key] = value
	local target: any = inst
	target[prop] = value
end

local function writeAttr(inst: Instance, name: string, value: number, eps: number)
	local key = "@" .. name
	if not LightingService._changed(written[key], value, eps) then
		return
	end
	written[key] = value
	inst:SetAttribute(name, value)
end

-- Test hook: engine sun direction (Lighting:GetSunDirection on a live server).
function LightingService._sunDirection(): Vector3?
	local ok, dir = pcall(function()
		return (Lighting :: any):GetSunDirection()
	end)
	if ok and typeof(dir) == "Vector3" then
		return dir
	end
	return nil
end

local function tuning(): Look.Tuning
	local override = Workspace:GetAttribute("AtmosphereOffsetOverride")
	if typeof(override) == "number" then
		return { offset = override, hazeScale = Look.Tuning.hazeScale, densityScale = Look.Tuning.densityScale }
	end
	return Look.Tuning
end

local function currentHour(): number
	local lock = Workspace:GetAttribute("TimeOfDayLock")
	if typeof(lock) == "number" then
		cycleStart = os.clock() - LightingService.timeForHour(lock)
		return lock % 24
	end
	return LightingService.hourAt(os.clock() - cycleStart)
end

---------------------------------------------------------------------------------------------------------------------
-- Appliers
---------------------------------------------------------------------------------------------------------------------

local function applyLook(hour: number)
	local look = LightingService.lookAt(hour, tuning())
	write(Lighting, "L.Brightness", "Brightness", look.brightness, 0.02)
	write(Lighting, "L.Exposure", "ExposureCompensation", look.exposure, 0.01)
	write(Lighting, "L.Ambient", "Ambient", rgb(look.ambient), COLOR_EPS)
	write(Lighting, "L.OutdoorAmbient", "OutdoorAmbient", rgb(look.outdoorAmbient), COLOR_EPS)
	write(Lighting, "L.ShadowSoftness", "ShadowSoftness", look.shadowSoftness, 0.01)
	local a = look.atmosphere
	write(atmosphere, "A.Density", "Density", a.density, 0.004)
	write(atmosphere, "A.Offset", "Offset", a.offset, 0.005)
	write(atmosphere, "A.Haze", "Haze", a.haze, 0.02)
	write(atmosphere, "A.Glare", "Glare", a.glare, 0.02)
	write(atmosphere, "A.Color", "Color", rgb(a.color), COLOR_EPS)
	write(atmosphere, "A.Decay", "Decay", rgb(a.decay), COLOR_EPS)
	write(bloom, "B.Intensity", "Intensity", look.bloom.intensity, 0.01)
	write(bloom, "B.Size", "Size", look.bloom.size, 0.5)
	write(bloom, "B.Threshold", "Threshold", look.bloom.threshold, 0.01)
	local cc = look.colorCorrection
	write(color, "C.Brightness", "Brightness", cc.brightness, 0.004)
	write(color, "C.Contrast", "Contrast", cc.contrast, 0.004)
	write(color, "C.Saturation", "Saturation", cc.saturation, 0.004)
	write(color, "C.Tint", "TintColor", rgb(cc.tint), COLOR_EPS)
	write(sunRays, "R.Intensity", "Intensity", look.sunRays.intensity, 0.004)
	write(sunRays, "R.Spread", "Spread", look.sunRays.spread, 0.01)
	local cl = look.clouds
	write(clouds, "K.Cover", "Cover", cl.cover, 0.01)
	write(clouds, "K.Density", "Density", cl.density, 0.01)
	write(clouds, "K.Color", "Color", rgb(cl.color), COLOR_EPS)
end

local FACE_PROPS = { "Bk", "Dn", "Ft", "Lf", "Rt", "Up" }

local function applySky(hour: number)
	if not sky then
		return
	end
	local name = LightingService.skyAt(hour)
	local def = Look.Skies[name]
	local swapped = false
	if name ~= currentSky then
		currentSky = name
		swapped = true
		if def then
			local target: any = sky
			for _, f in FACE_PROPS do
				local id = def.faces[f]
				if typeof(id) == "string" and id ~= "" then
					target["Skybox" .. f] = id
				end
			end
			sky.StarCount = def.starCount
		end
		Lighting:SetAttribute("Sky", name)
	end
	if not def or not (swapped or def.followSun) then
		return
	end
	local dir = LightingService._sunDirection()
	if not dir then
		return
	end
	local yaw = LightingService.skyYaw(def.glowAzimuth, dir.X, dir.Z)
	if yaw == nil then
		return
	end
	if skyYawWritten == nil or math.abs(wrapDeg(yaw - skyYawWritten)) >= Look.SkyStyle.yawEpsilon or swapped then
		skyYawWritten = yaw
		sky.SkyboxOrientation = Vector3.new(0, yaw, 0)
	end
end

local function materialFrom(name: any, fallback: Enum.Material): Enum.Material
	if typeof(name) ~= "string" then
		return fallback
	end
	local ok, mat = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	if ok and typeof(mat) == "EnumItem" then
		return mat
	end
	return fallback
end

-- Applies the day/night look to one tagged part (NightGlow).
local function applyGlow(inst: Instance, isNight: boolean)
	if not inst:IsA("BasePart") or not inst.Parent then
		return
	end
	local colorAttr = inst:GetAttribute(if isNight then "NightColor" else "DayColor")
	if typeof(colorAttr) == "Color3" then
		inst.Color = colorAttr
	end
	local matAttr = inst:GetAttribute(if isNight then "NightMaterial" else "DayMaterial")
	if matAttr ~= nil then
		inst.Material = materialFrom(matAttr, inst.Material)
	end
end

local function applyStreetLight(inst: Instance, isNight: boolean)
	if not inst.Parent then
		return
	end
	for _, child in inst:GetChildren() do
		if child:IsA("PointLight") or child:IsA("SpotLight") or child:IsA("SurfaceLight") then
			child.Enabled = isNight
		end
	end
end

-- Applies the night state to every tagged instance. With `spread`, NightGlow swaps are batched over frames.
local function applyNightState(isNight: boolean, spread: boolean)
	glowVersion += 1
	local version = glowVersion
	for _, inst in CollectionService:GetTagged(LightingService.TAG_STREET_LIGHT) do
		applyStreetLight(inst, isNight)
	end
	local glows = CollectionService:GetTagged(LightingService.TAG_NIGHT_GLOW)
	if not spread then
		for _, inst in glows do
			applyGlow(inst, isNight)
		end
		return
	end
	task.spawn(function()
		for i, inst in glows do
			if version ~= glowVersion then
				return -- a newer transition took over
			end
			applyGlow(inst, isNight)
			if i % LightingService.GLOW_BATCH == 0 then
				task.wait()
			end
		end
	end)
end

local function applyWetStreets(isNight: boolean)
	local w = Look.WetStreets
	if not w.enabled then
		return
	end
	local ok, err = pcall(function()
		local MaterialService = game:GetService("MaterialService")
		local name = if isNight then w.wet else w.dry
		if MaterialService:FindFirstChild(name) then
			MaterialService:SetBaseMaterialOverride(Enum.Material.Asphalt, name)
		end
	end)
	if not ok then
		warn("[LightingService] wet streets: " .. tostring(err))
	end
end

local function setNight(isNight: boolean, spread: boolean)
	night = isNight
	Lighting:SetAttribute("IsNight", isNight)
	applyNightState(isNight, spread)
	applyWetStreets(isNight)
	LightingService.NightChanged:Fire(isNight)
end

-- NightFactor + TimeOfDay attributes, and the v1 IsNight switch (hysteresis around Look.Night.lightsOn).
local function applyClockState(hour: number, spread: boolean)
	nightFactor = LightingService.nightFactorAt(hour)
	local nf = math.floor(nightFactor * 100 + 0.5) / 100
	writeAttr(Workspace, "NightFactor", nf, 0.01)
	writeAttr(Workspace, "TimeOfDay", math.floor(hour * 100 + 0.5) / 100, 0.05)
	local on, hys = Look.Night.lightsOn, Look.Night.hysteresis
	if not night and nightFactor >= on + hys then
		setNight(true, spread)
	elseif night and nightFactor <= on - hys then
		setNight(false, spread)
	end
end

local function applyAll(hour: number, spread: boolean)
	write(Lighting, "L.ClockTime", "ClockTime", hour, 0.0005)
	applyLook(hour)
	applySky(hour)
	applyClockState(hour, spread)
end

---------------------------------------------------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------------------------------------------------

function LightingService.isNight(): boolean
	return night
end

function LightingService.getNightFactor(): number
	return nightFactor
end

function LightingService.getClockTime(): number
	return currentHour()
end

-- Jump the cycle to an hour (admin/testing). Everything (look, sky, attributes, night state) updates immediately.
function LightingService.setClockTime(hour: number)
	cycleStart = os.clock() - LightingService.timeForHour(hour)
	applyAll(hour % 24, true)
end

-- One Sky / Atmosphere / effect of each managed class: adopt the place file's (Rojo-built) instance by name, else the
-- first of its class, destroy duplicates (Roblox renders one Sky/Atmosphere; post effects stack).
local function adopt(className: string, name: string): Instance
	local keep: Instance? = Lighting:FindFirstChild(name)
	if keep and not keep:IsA(className) then
		keep = nil
	end
	for _, c in Lighting:GetChildren() do
		if c:IsA(className) then
			if keep == nil then
				keep = c
			elseif c ~= keep then
				c:Destroy()
			end
		end
	end
	if keep == nil then
		local inst = Instance.new(className)
		inst.Name = name
		inst.Parent = Lighting
		keep = inst
	end
	return keep :: Instance
end

function LightingService.init()
	-- NOTE: no Lighting.Technology write (deprecated, RobloxScript-only): LightingStyle/PrioritizeLightingQuality live
	-- in default.project.json.
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GeographicLatitude = 34 -- Los Angeles
	Lighting.FogEnd = 100000

	local s = adopt("Sky", "Sky") :: Sky
	s.SunAngularSize = Look.SkyStyle.sunAngularSize
	s.MoonAngularSize = Look.SkyStyle.moonAngularSize
	s.CelestialBodiesShown = Look.SkyStyle.celestialBodiesShown
	sky = s
	atmosphere = adopt("Atmosphere", "Atmosphere") :: Atmosphere
	bloom = adopt("BloomEffect", "Bloom") :: BloomEffect
	color = adopt("ColorCorrectionEffect", "ColorCorrection") :: ColorCorrectionEffect
	sunRays = adopt("SunRaysEffect", "SunRays") :: SunRaysEffect
	for _, c in Lighting:GetChildren() do
		-- depth of field / blur belong on the camera (menus, phone UI), never on the whole world
		if c:IsA("DepthOfFieldEffect") or c:IsA("BlurEffect") then
			c.Enabled = false
		end
	end

	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	clouds = nil
	if terrain then
		local ok = pcall(function()
			-- one Clouds only: adopt the one MapBuilder made (Terrain honours a single Clouds instance)
			local existing = terrain:FindFirstChildOfClass("Clouds")
			if existing then
				clouds = existing
			else
				local c = Instance.new("Clouds")
				c.Name = "HotwireClouds"
				c.Parent = terrain
				clouds = c
			end
		end)
		if not ok then
			warn("[LightingService] could not create clouds")
		end
	end

	table.clear(written) -- (re)adopted instances: the next apply writes everything
	currentSky = nil
	skyYawWritten = nil
	local hour = currentHour()
	nightFactor = LightingService.nightFactorAt(hour)
	night = nightFactor >= Look.Night.lightsOn
	Lighting:SetAttribute("IsNight", night)
	applyAll(hour, false)
	applyNightState(night, false)

	-- late-tagged instances (e.g. garages built later) pick up the current state
	CollectionService:GetInstanceAddedSignal(LightingService.TAG_NIGHT_GLOW):Connect(function(inst: Instance)
		task.defer(function()
			applyGlow(inst, night)
		end)
	end)
	CollectionService:GetInstanceAddedSignal(LightingService.TAG_STREET_LIGHT):Connect(function(inst: Instance)
		task.defer(function()
			applyStreetLight(inst, night)
		end)
	end)
end

function LightingService.start()
	local envAcc = 0
	while true do
		local dt = task.wait(Look.Cycle.clockInterval)
		local hour = currentHour()
		write(Lighting, "L.ClockTime", "ClockTime", hour, 0.0005)
		envAcc += dt
		if envAcc >= Look.Cycle.envInterval then
			envAcc = 0
			applyLook(hour)
			applySky(hour)
		end
		applyClockState(hour, true)
	end
end

return LightingService
