--!strict
-- LightingService v2: the GTA time of day (docs/v2/PLAN.md decision 3, research/lighting_lab.md, Config/Look).
--
-- * The place file carries what scripts cannot set: LightingStyle = Realistic, PrioritizeLightingQuality, the
--   MaterialVariants and the default Sky (default.project.json, generated by tools/look/gen_project.py). This service
--   animates the time of day and applies the runtime-settable look. Lighting.Technology is deprecated +
--   RobloxScript-only and is never written.
-- * Clock: a 24-minute day (Look.Cycle), night fast / dawn + dusk slow. ClockTime is written at 4 Hz.
-- * Sun: Roblox's sun path was measured in the real engine (Look.Sun; sunrise 06:00, sunset 18:00 at every latitude,
--   79.5 deg culmination at latitude 34). sunDirectionAt reproduces it; the engine's GetSunDirection is used live.
-- * Look: keyframed presets (night, blue hour, golden morning, day, golden evening, blue hour) smoothstepped every
--   1 s; Atmosphere capped at Density 0.30 / Haze 1.2 (lab round 1), Offset tunable (Look.Tuning / Workspace attribute
--   "AtmosphereOffsetOverride"). Writes are cheap: a property is only written when it moved past a per-property
--   epsilon since the last write (plateaus cost nothing).
-- * Sky: HDRI skies (Look.Skies) swapped on Look.SkySchedule at moments the change is hard to see (sun below the
--   horizon, or under a short haze bump with the golden sky only up while the sun is low); per-sky stars, sun/moon
--   discs and volumetric cloud share. A following sky's glow is kept on the engine sun at most Look.SkyStyle.maxYawRate
--   deg/s (smooth, never a visible spin); the night sky parks its city glow inland.
-- * Lit windows: tag "LitWindow" (and v1 glass NightGlow parts) light up over dusk, a deterministic ~half of them,
--   warm and cool, each at its own NightFactor (Look.Windows).
-- * Terrain: water colour/reflectance (Look.Water) and the terrain material colours that match the MaterialVariant
--   colour maps (Look.TerrainColors), applied after MapBuilder. Optional wet streets at night (Look.WetStreets).
-- * Published state for other systems: Workspace attributes "NightFactor" (0 day .. 1 night, smooth; lit windows,
--   street lights) and "TimeOfDay" (hours, 0..24); Lighting attribute "Sky". Workspace attributes "TimeOfDayLock"
--   (hours), "AtmosphereOffsetOverride" and "CloudsOverride" are live overrides for screenshots / lab round 2.
-- * v1 contract kept: Lighting attribute "IsNight", NightChanged(isNight), tags "StreetLight" (lights on at night)
--   and "NightGlow" (DayColor/DayMaterial <-> NightColor/NightMaterial swaps), switched at NightFactor ~0.5.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Look = require(ReplicatedStorage.Shared.Config.Look)
local Signal = require(ReplicatedStorage.Shared.Util.Signal)

type Preset = Look.Preset
type RGB = Look.RGB
type WindowParams = Look.WindowParams

local LightingService = {}

LightingService.TAG_STREET_LIGHT = "StreetLight"
LightingService.TAG_NIGHT_GLOW = "NightGlow"
LightingService.TAG_LIT_WINDOW = Look.Windows.tag
LightingService.GLOW_BATCH = 150 -- NightGlow parts swapped per frame
LightingService.CYCLE_SECONDS = Look.Cycle.lengthSeconds
LightingService.START_HOUR = Look.Cycle.startHour
LightingService.ENV_INTERVAL = Look.Cycle.envInterval
LightingService.CLOCK_INTERVAL = Look.Cycle.clockInterval

LightingService.NightChanged = Signal.new() -- (isNight: boolean)

---------------------------------------------------------------------------------------------------------------------
-- Pure helpers (unit-tested in tests/spec/look.spec.luau)
---------------------------------------------------------------------------------------------------------------------

local function clamp01(x: number): number
	return math.clamp(x, 0, 1)
end

local function smoothstep(e0: number, e1: number, x: number): number
	local t = clamp01((x - e0) / (e1 - e0))
	return t * t * (3 - 2 * t)
end

-- Clock segments: the bands' relative speeds normalised so a whole day lasts Look.Cycle.lengthSeconds.
type Segment = { from: number, to: number, t0: number, t1: number }
local SEGMENTS: { Segment } = {}
do
	local weighted = 0
	for _, b in Look.Cycle.bands do
		weighted += (b.to - b.from) * b.weight
	end
	local perUnit = Look.Cycle.lengthSeconds / weighted
	local t = 0
	for _, b in Look.Cycle.bands do
		local dur = (b.to - b.from) * b.weight * perUnit
		table.insert(SEGMENTS, { from = b.from, to = b.to, t0 = t, t1 = t + dur })
		t += dur
	end
end
LightingService.SEGMENTS = SEGMENTS

-- ClockTime (0..24) at `t` seconds into the cycle (t = 0 is midnight).
function LightingService.hourAt(t: number): number
	local tt = t % Look.Cycle.lengthSeconds
	for _, s in SEGMENTS do
		if tt < s.t1 then
			return s.from + (s.to - s.from) * ((tt - s.t0) / (s.t1 - s.t0))
		end
	end
	return 0
end

-- Cycle time (seconds) at which the clock shows `hour`.
function LightingService.timeForHour(hour: number): number
	local h = hour % 24
	for _, s in SEGMENTS do
		if h < s.to then
			return s.t0 + (s.t1 - s.t0) * ((h - s.from) / (s.to - s.from))
		end
	end
	return 0
end

-- Recursively interpolates two preset trees (numbers and {r,g,b} arrays).
local function lerpTree(a: any, b: any, t: number): any
	if type(a) == "number" then
		return a + (b - a) * t
	end
	local out = {}
	for k, v in a do
		out[k] = lerpTree(v, b[k], t)
	end
	return out
end

-- The engine sun direction (unit vector components) at an hour, as measured in the real engine (Look.Sun): a circle
-- about the horizontal Z axis, tilted by phi = latitude - 23.5 deg; theta = 15 deg per hour from 06:00.
function LightingService.sunDirectionAt(hour: number, latitude: number?): (number, number, number)
	local phi = math.rad((latitude or Look.Sun.latitude) - Look.Sun.tiltOffset)
	local theta = math.rad(15 * ((hour % 24) - 6))
	local c = math.cos(phi)
	return c * math.cos(theta), c * math.sin(theta), math.sin(phi)
end

-- Engine sun elevation in degrees at an hour (negative = below the horizon).
function LightingService.sunElevationAt(hour: number, latitude: number?): number
	local _, y, _ = LightingService.sunDirectionAt(hour, latitude)
	return math.deg(math.asin(math.clamp(y, -1, 1)))
end

-- Extra Atmosphere.Haze around each sky swap (gaussian in game hours, circular over midnight).
function LightingService.swapHazeAt(hour: number): number
	local h = hour % 24
	local best = 0
	for _, e in Look.SkySchedule do
		local d = math.abs(h - e.hour)
		d = math.min(d, 24 - d)
		best = math.max(best, Look.SkySwap.hazeBoost * math.exp(-(d / Look.SkySwap.width) ^ 2))
	end
	return best
end

-- Interpolated look for an hour (0..24): keyframes smoothstepped, then tuning, sky-swap haze and the lab caps.
function LightingService.lookAt(hour: number, tuning: Look.Tuning?): Preset
	local h = hour % 24
	local keys = Look.Keys
	local a, b = keys[1], keys[#keys]
	for i = 1, #keys - 1 do
		if h >= keys[i].hour and h <= keys[i + 1].hour then
			a, b = keys[i], keys[i + 1]
			break
		end
	end
	local span = b.hour - a.hour
	local t = if span > 0 then (h - a.hour) / span else 0
	t = t * t * (3 - 2 * t)
	local look: Preset = lerpTree(Look.Presets[a.preset], Look.Presets[b.preset], t)
	local tune: Look.Tuning = tuning or Look.Tuning
	local atmo = look.atmosphere
	if tune.offset ~= nil then
		atmo.offset = tune.offset
	end
	atmo.density = math.min(atmo.density * tune.densityScale, Look.Caps.densityMax)
	atmo.haze = math.min(atmo.haze * tune.hazeScale + LightingService.swapHazeAt(h), Look.Caps.hazeMax)
	return look
end

-- 0 = day .. 1 = night, smooth ramps at dusk and dawn.
function LightingService.nightFactorAt(hour: number): number
	local h = hour % 24
	local n = Look.Night
	if h >= n.duskStart then
		return smoothstep(n.duskStart, n.duskFull, h)
	elseif h < n.dawnFull then
		return 1
	end
	return 1 - smoothstep(n.dawnFull, n.dawnEnd, h)
end

-- Which sky is up at an hour (the last schedule entry at or before it; wraps over midnight).
function LightingService.skyAt(hour: number): string
	local h = hour % 24
	local sched = Look.SkySchedule
	local name = sched[#sched].sky
	for _, e in sched do
		if h >= e.hour then
			name = e.sky
		end
	end
	return name
end

-- Hours until the next sky swap from `hour`, and the sky it swaps to.
function LightingService.nextSkySwap(hour: number): (number, string)
	local h = hour % 24
	local bestDt, bestSky = math.huge, Look.SkySchedule[1].sky
	for _, e in Look.SkySchedule do
		local dt = (e.hour - h) % 24
		if dt > 0 and dt < bestDt then
			bestDt, bestSky = dt, e.sky
		end
	end
	return bestDt, bestSky
end

local function skyClouds(name: string): number
	local def = Look.Skies[name]
	return if def then def.clouds else 1
end

-- Share of the preset's volumetric cloud cover while a sky is up (Look.Skies[*].clouds), blended smoothly across
-- +-Look.SkySwap.width hours around each swap so clouds fade instead of popping.
function LightingService.cloudScaleAt(hour: number): number
	local h = hour % 24
	local w = Look.SkySwap.width
	local sched = Look.SkySchedule
	for i, e in sched do
		local d = h - e.hour
		if d > 12 then
			d -= 24
		elseif d < -12 then
			d += 24
		end
		if math.abs(d) < w then
			local prev = sched[if i == 1 then #sched else i - 1].sky
			local t = smoothstep(-w, w, d)
			return skyClouds(prev) + (skyClouds(e.sky) - skyClouds(prev)) * t
		end
	end
	return skyClouds(LightingService.skyAt(h))
end

-- Azimuth in degrees of a direction: 0 = -Z, 90 = +X (the convention tools/look/hdri_to_skybox.py records).
function LightingService.azimuthOf(x: number, z: number): number
	return math.deg(math.atan2(x, -z))
end

local function wrapDeg(d: number): number
	local w = (d + 180) % 360 - 180
	return if w == -180 then 180 else w
end
LightingService.wrapDeg = wrapDeg

-- SkyboxOrientation.Y that turns a sky feature at azimuth `skyAzimuth` to azimuth `targetAzimuth` (degrees).
function LightingService.yawToward(skyAzimuth: number, targetAzimuth: number, sign: number?): number
	return wrapDeg((sign or Look.SkyStyle.yawSign) * (skyAzimuth - targetAzimuth))
end

-- SkyboxOrientation.Y that puts a sky's glow (at azimuth `skyAzimuth`, degrees) under the engine sun direction
-- (x, z = horizontal components). nil when the sun is (nearly) overhead and the azimuth is meaningless.
function LightingService.skyYaw(skyAzimuth: number, sunX: number, sunZ: number, sign: number?): number?
	if math.sqrt(sunX * sunX + sunZ * sunZ) < 0.05 then
		return nil
	end
	return LightingService.yawToward(skyAzimuth, LightingService.azimuthOf(sunX, sunZ), sign)
end

-- Moves an angle toward a target by at most maxStep degrees, the short way round.
function LightingService.stepYaw(current: number, target: number, maxStep: number): number
	local d = wrapDeg(target - current)
	if math.abs(d) <= maxStep then
		return wrapDeg(target)
	end
	return wrapDeg(current + (if d > 0 then maxStep else -maxStep))
end

-- 32-bit integer helpers for the window hash (exact in doubles: every product stays below 2^53).
local TWO32 = 4294967296
local function mul32(a: number, b: number): number
	local bl = b % 65536
	local bh = (b - bl) / 65536
	return (a * bl + ((a * bh) % 65536) * 65536) % TWO32
end
local function fmix32(h: number): number
	h = bit32.bxor(h, bit32.rshift(h, 16))
	h = mul32(h, 0x85EBCA6B)
	h = bit32.bxor(h, bit32.rshift(h, 13))
	h = mul32(h, 0xC2B2AE35)
	return bit32.bxor(h, bit32.rshift(h, 16))
end

-- Deterministic per-window look from its position (studs; rounded to half a stud so tiny float noise does not matter):
-- whether it lights at all, warm or cool, brightness, and the NightFactor it switches at (Look.Windows).
function LightingService.windowParams(x: number, y: number, z: number): WindowParams
	local function q(v: number): number
		return math.floor(v * 2 + 0.5) % TWO32
	end
	local h = fmix32(bit32.bxor(mul32(q(x), 0x9E3779B1), mul32(q(y), 0x85EBCA77), mul32(q(z), 0xC2B2AE3D)))
	local function u(seed: number): number
		return fmix32(bit32.bxor(h, seed)) / TWO32
	end
	local W = Look.Windows
	return {
		lit = u(0x68E31DA4) < W.share,
		warm = u(0xB5297A4D) < W.warmShare,
		brightness = W.brightness[1] + (W.brightness[2] - W.brightness[1]) * u(0x1B56C4E9),
		threshold = W.onBand[1] + (W.onBand[2] - W.onBand[1]) * u(0x2F3A9C71),
	}
end

-- Write-skip test: has `value` moved far enough from the last written `last` (nil = never written)? Colors compare
-- per channel. Pure, unit-tested.
function LightingService._changed(last: any, value: any, eps: number): boolean
	if last == nil or typeof(last) ~= typeof(value) then
		return true
	end
	if typeof(value) == "Color3" then
		return math.max(math.abs(last.R - value.R), math.abs(last.G - value.G), math.abs(last.B - value.B)) >= eps
	end
	if typeof(value) == "Vector3" then
		return (last - value).Magnitude >= eps
	end
	if typeof(value) == "number" then
		return math.abs(last - value) >= eps
	end
	return last ~= value
end

---------------------------------------------------------------------------------------------------------------------
-- State
---------------------------------------------------------------------------------------------------------------------

local cycleStart = os.clock() - LightingService.timeForHour(Look.Cycle.startHour)
local night = LightingService.nightFactorAt(Look.Cycle.startHour) >= Look.Night.lightsOn
local nightFactor = LightingService.nightFactorAt(Look.Cycle.startHour)
local wet = false
local glowVersion = 0
local currentSky: string? = nil
local skyYawCurrent: number? = nil
local skyYawWritten: number? = nil
local connected = false

type WindowState = { params: WindowParams, color: Color3, on: boolean? }
local windows: { [BasePart]: WindowState } = {}
local windowNf: number? = nil
local windowVersion = 0

local sky: Sky? = nil
local atmosphere: Atmosphere? = nil
local bloom: BloomEffect? = nil
local color: ColorCorrectionEffect? = nil
local sunRays: SunRaysEffect? = nil
local clouds: Clouds? = nil

local COLOR_EPS = 1.5 / 255
local written: { [string]: any } = {} -- last value written per "Object.Property" (see LightingService._changed)

local function rgb(c: RGB): Color3
	return Color3.fromRGB(c[1], c[2], c[3])
end

local function write(inst: Instance?, key: string, prop: string, value: any, eps: number)
	if not inst or not LightingService._changed(written[key], value, eps) then
		return
	end
	written[key] = value
	local target: any = inst
	target[prop] = value
end

local function writeAttr(inst: Instance, name: string, value: number, eps: number): boolean
	local key = "@" .. name
	if not LightingService._changed(written[key], value, eps) then
		return false
	end
	written[key] = value
	inst:SetAttribute(name, value)
	return true
end

-- Test hook: engine sun direction (Lighting:GetSunDirection on a live server; nil headless).
function LightingService._sunDirection(): Vector3?
	local ok, dir = pcall(function()
		return (Lighting :: any):GetSunDirection()
	end)
	if ok and typeof(dir) == "Vector3" then
		return dir
	end
	return nil
end

-- Test hook: Terrain:SetMaterialColor (not implemented headless).
function LightingService._setTerrainColor(terrain: Terrain, material: Enum.Material, c: Color3)
	terrain:SetMaterialColor(material, c)
end

-- Test hook: MaterialService:SetBaseMaterialOverride(Asphalt, name) (wet streets).
function LightingService._setAsphaltOverride(name: string)
	local MaterialService = game:GetService("MaterialService")
	if MaterialService:FindFirstChild(name) then
		MaterialService:SetBaseMaterialOverride(Enum.Material.Asphalt, name)
	end
end

local function tuning(): Look.Tuning
	local override = Workspace:GetAttribute("AtmosphereOffsetOverride")
	if typeof(override) == "number" then
		return { offset = override, hazeScale = Look.Tuning.hazeScale, densityScale = Look.Tuning.densityScale }
	end
	return Look.Tuning
end

local function cloudsOverride(): number
	local v = Workspace:GetAttribute("CloudsOverride")
	return if typeof(v) == "number" then math.max(v, 0) else 1
end

local function currentHour(): number
	local lock = Workspace:GetAttribute("TimeOfDayLock")
	if typeof(lock) == "number" then
		cycleStart = os.clock() - LightingService.timeForHour(lock)
		return lock % 24
	end
	return LightingService.hourAt(os.clock() - cycleStart)
end

---------------------------------------------------------------------------------------------------------------------
-- Appliers
---------------------------------------------------------------------------------------------------------------------

local function applyLook(hour: number)
	local look = LightingService.lookAt(hour, tuning())
	write(Lighting, "L.Brightness", "Brightness", look.brightness, 0.02)
	write(Lighting, "L.Exposure", "ExposureCompensation", look.exposure, 0.01)
	write(Lighting, "L.Ambient", "Ambient", rgb(look.ambient), COLOR_EPS)
	write(Lighting, "L.OutdoorAmbient", "OutdoorAmbient", rgb(look.outdoorAmbient), COLOR_EPS)
	write(Lighting, "L.ShadowSoftness", "ShadowSoftness", look.shadowSoftness, 0.01)
	local a = look.atmosphere
	write(atmosphere, "A.Density", "Density", a.density, 0.004)
	write(atmosphere, "A.Offset", "Offset", a.offset, 0.005)
	write(atmosphere, "A.Haze", "Haze", a.haze, 0.02)
	write(atmosphere, "A.Glare", "Glare", a.glare, 0.02)
	write(atmosphere, "A.Color", "Color", rgb(a.color), COLOR_EPS)
	write(atmosphere, "A.Decay", "Decay", rgb(a.decay), COLOR_EPS)
	write(bloom, "B.Intensity", "Intensity", look.bloom.intensity, 0.01)
	write(bloom, "B.Size", "Size", look.bloom.size, 0.5)
	write(bloom, "B.Threshold", "Threshold", look.bloom.threshold, 0.01)
	local cc = look.colorCorrection
	write(color, "C.Brightness", "Brightness", cc.brightness, 0.004)
	write(color, "C.Contrast", "Contrast", cc.contrast, 0.004)
	write(color, "C.Saturation", "Saturation", cc.saturation, 0.004)
	write(color, "C.Tint", "TintColor", rgb(cc.tint), COLOR_EPS)
	write(sunRays, "R.Intensity", "Intensity", look.sunRays.intensity, 0.004)
	write(sunRays, "R.Spread", "Spread", look.sunRays.spread, 0.01)
	local cl = look.clouds
	local cover = cl.cover * LightingService.cloudScaleAt(hour) * cloudsOverride()
	write(clouds, "K.Cover", "Cover", math.clamp(cover, 0, 1), 0.01)
	write(clouds, "K.Density", "Density", cl.density, 0.01)
	write(clouds, "K.Color", "Color", rgb(cl.color), COLOR_EPS)
end

local FACE_PROPS = { "Bk", "Dn", "Ft", "Lf", "Rt", "Up" }

-- Sky faces / stars / sun-moon discs on a swap, and the yaw: a following sky's glow eases toward the engine sun at
-- most maxYawRate * dt degrees (dt = math.huge snaps), a fixed sky parks its horizon glow on fixedGlowAzimuth.
local function applySky(hour: number, dt: number)
	if not sky then
		return
	end
	local name = LightingService.skyAt(hour)
	local def = Look.Skies[name]
	local swapped = false
	if name ~= currentSky then
		currentSky = name
		swapped = true
		if def then
			local target: any = sky
			for _, f in FACE_PROPS do
				local id = def.faces[f]
				if typeof(id) == "string" and id ~= "" then
					target["Skybox" .. f] = id
				end
			end
			sky.StarCount = def.starCount
			sky.CelestialBodiesShown = def.celestialBodiesShown
		end
		Lighting:SetAttribute("Sky", name)
	end
	if not def then
		return
	end
	local targetYaw: number?
	if def.followSun then
		local dir = LightingService._sunDirection()
		local x, z
		if dir then
			x, z = dir.X, dir.Z
		else
			local sx, _, sz = LightingService.sunDirectionAt(hour, Lighting.GeographicLatitude)
			x, z = sx, sz
		end
		targetYaw = LightingService.skyYaw(def.glowAzimuth, x, z)
	else
		targetYaw = LightingService.yawToward(def.horizonGlowAzimuth, Look.SkyStyle.fixedGlowAzimuth)
	end
	if targetYaw == nil then
		return
	end
	local cur = skyYawCurrent
	if swapped or cur == nil then
		cur = targetYaw
	else
		cur = LightingService.stepYaw(cur, targetYaw, Look.SkyStyle.maxYawRate * dt)
	end
	skyYawCurrent = cur
	local last = skyYawWritten
	if swapped or last == nil or math.abs(wrapDeg(cur - last)) >= Look.SkyStyle.yawEpsilon then
		skyYawWritten = cur
		sky.SkyboxOrientation = Vector3.new(0, cur, 0)
	end
end
LightingService._applySky = applySky -- test hook: one clock tick of the sky (hour, dt seconds)

local function materialFrom(name: any, fallback: Enum.Material): Enum.Material
	if typeof(name) ~= "string" then
		return fallback
	end
	local ok, mat = pcall(function()
		return (Enum.Material :: any)[name]
	end)
	if ok and typeof(mat) == "EnumItem" then
		return mat
	end
	return fallback
end

-- Lit windows -------------------------------------------------------------------------------------------------------

-- v1 buildings: glass NightGlow parts (DayMaterial Glass) are windows, handled here instead of the plain glow swap.
local function isAdoptedGlow(inst: Instance): boolean
	return Look.Windows.adoptGlassNightGlow
		and inst:IsA("BasePart")
		and CollectionService:HasTag(inst, LightingService.TAG_NIGHT_GLOW)
		and inst:GetAttribute("DayMaterial") == "Glass"
		and not CollectionService:HasTag(inst, LightingService.TAG_STREET_LIGHT)
end

local function setWindow(part: BasePart, st: WindowState, on: boolean)
	if st.on == on then
		return
	end
	st.on = on
	if on then
		part.Material = materialFrom(Look.Windows.material, Enum.Material.Neon)
		part.Color = st.color
	else
		local dayColor = part:GetAttribute("DayColor")
		if typeof(dayColor) == "Color3" then
			part.Color = dayColor
		end
		part.Material = materialFrom(part:GetAttribute("DayMaterial"), part.Material)
	end
end

local function windowOn(st: WindowState, nf: number): boolean
	return st.params.lit and nf >= st.params.threshold
end

local function registerWindow(inst: Instance)
	if not inst:IsA("BasePart") or windows[inst] then
		return
	end
	if inst:GetAttribute("DayColor") == nil then
		inst:SetAttribute("DayColor", inst.Color)
	end
	if inst:GetAttribute("DayMaterial") == nil then
		inst:SetAttribute("DayMaterial", inst.Material.Name)
	end
	local p = inst.CFrame.Position
	local params = LightingService.windowParams(p.X, p.Y, p.Z)
	local W = Look.Windows
	local override = inst:GetAttribute("LitWindowColor")
	local base = if typeof(override) == "Color3" then override else rgb(if params.warm then W.warm else W.cool)
	local k = params.brightness
	local st: WindowState = { params = params, color = Color3.new(base.R * k, base.G * k, base.B * k), on = nil }
	windows[inst] = st
	setWindow(inst, st, windowOn(st, nightFactor))
end

local function unregisterWindow(inst: Instance)
	if inst:IsA("BasePart") then
		windows[inst] = nil
	end
end

-- Switches every registered window to its state at NightFactor `nf` (only the ones that change are written). With
-- `spread`, Look.Windows.batch switches per frame; a newer update supersedes a running one.
local function updateWindows(nf: number, spread: boolean)
	windowNf = nf
	windowVersion += 1
	local version = windowVersion
	local list: { BasePart } = {}
	for part, st in windows do
		if part.Parent == nil then
			windows[part] = nil
		elseif windowOn(st, nf) ~= st.on then
			table.insert(list, part)
		end
	end
	if #list == 0 then
		return
	end
	local function run(yield: boolean)
		for i, part in list do
			if version ~= windowVersion then
				return
			end
			local st = windows[part]
			if st and part.Parent then
				setWindow(part, st, windowOn(st, nf))
			end
			if yield and i % Look.Windows.batch == 0 then
				task.wait()
			end
		end
	end
	if spread and #list > Look.Windows.batch then
		task.spawn(run, true)
	else
		run(false)
	end
end

-- v1 NightGlow / StreetLight ------------------------------------------------------------------------------------------

-- Applies the day/night look to one tagged part (NightGlow); adopted windows are left to the window system.
local function applyGlow(inst: Instance, isNight: boolean)
	if not inst:IsA("BasePart") or not inst.Parent or windows[inst] then
		return
	end
	local colorAttr = inst:GetAttribute(if isNight then "NightColor" else "DayColor")
	if typeof(colorAttr) == "Color3" then
		inst.Color = colorAttr
	end
	local matAttr = inst:GetAttribute(if isNight then "NightMaterial" else "DayMaterial")
	if matAttr ~= nil then
		inst.Material = materialFrom(matAttr, inst.Material)
	end
end

local function applyStreetLight(inst: Instance, isNight: boolean)
	if not inst.Parent then
		return
	end
	for _, child in inst:GetChildren() do
		if child:IsA("PointLight") or child:IsA("SpotLight") or child:IsA("SurfaceLight") then
			child.Enabled = isNight
		end
	end
end

-- Applies the night state to every tagged instance. With `spread`, NightGlow swaps are batched over frames.
local function applyNightState(isNight: boolean, spread: boolean)
	glowVersion += 1
	local version = glowVersion
	for _, inst in CollectionService:GetTagged(LightingService.TAG_STREET_LIGHT) do
		applyStreetLight(inst, isNight)
	end
	local glows = CollectionService:GetTagged(LightingService.TAG_NIGHT_GLOW)
	if not spread then
		for _, inst in glows do
			applyGlow(inst, isNight)
		end
		return
	end
	task.spawn(function()
		for i, inst in glows do
			if version ~= glowVersion then
				return -- a newer transition took over
			end
			applyGlow(inst, isNight)
			if i % LightingService.GLOW_BATCH == 0 then
				task.wait()
			end
		end
	end)
end

-- Wet streets -----------------------------------------------------------------------------------------------------

-- Wet-street state with hysteresis around Look.WetStreets.nightFactor. Pure.
function LightingService.wetAt(nf: number, wasWet: boolean): boolean
	local w, hys = Look.WetStreets, Look.Night.hysteresis
	if wasWet then
		return nf > w.nightFactor - hys
	end
	return nf >= w.nightFactor + hys
end

local function applyWetStreets(isWet: boolean)
	local w = Look.WetStreets
	wet = isWet
	if not w.enabled then
		return
	end
	local ok, err = pcall(LightingService._setAsphaltOverride, if isWet then w.wet else w.dry)
	if not ok then
		warn("[LightingService] wet streets: " .. tostring(err))
	end
end

local function setNight(isNight: boolean, spread: boolean)
	night = isNight
	Lighting:SetAttribute("IsNight", isNight)
	applyNightState(isNight, spread)
	LightingService.NightChanged:Fire(isNight)
end

-- NightFactor + TimeOfDay attributes, the v1 IsNight switch (hysteresis around Look.Night.lightsOn), lit windows and
-- wet streets.
local function applyClockState(hour: number, spread: boolean)
	nightFactor = LightingService.nightFactorAt(hour)
	local nf = math.floor(nightFactor * 100 + 0.5) / 100
	writeAttr(Workspace, "NightFactor", nf, 0.01)
	writeAttr(Workspace, "TimeOfDay", math.floor(hour * 100 + 0.5) / 100, 0.05)
	local on, hys = Look.Night.lightsOn, Look.Night.hysteresis
	if not night and nightFactor >= on + hys then
		setNight(true, spread)
	elseif night and nightFactor <= on - hys then
		setNight(false, spread)
	end
	local lastNf = windowNf
	if lastNf == nil or math.abs(nf - lastNf) >= 0.005 then
		updateWindows(nf, spread)
	end
	local nowWet = LightingService.wetAt(nightFactor, wet)
	if nowWet ~= wet then
		applyWetStreets(nowWet)
	end
end

local function applyAll(hour: number, spread: boolean)
	write(Lighting, "L.ClockTime", "ClockTime", hour, 0.0005)
	applyLook(hour)
	applySky(hour, math.huge)
	applyClockState(hour, spread)
end

-- Terrain water + the terrain material colours of the colour contract (Look.Water, Look.TerrainColors).
local function applyTerrainLook(terrain: Terrain)
	local w = Look.Water
	terrain.WaterColor = rgb(w.color)
	terrain.WaterTransparency = w.transparency
	terrain.WaterReflectance = w.reflectance
	terrain.WaterWaveSize = w.waveSize
	terrain.WaterWaveSpeed = w.waveSpeed
	local failed: { string } = {}
	local lastErr = ""
	for name, c in Look.TerrainColors do
		local ok, err = pcall(function()
			LightingService._setTerrainColor(terrain, (Enum.Material :: any)[name], rgb(c))
		end)
		if not ok then
			table.insert(failed, name)
			lastErr = tostring(err)
		end
	end
	if #failed > 0 then
		table.sort(failed)
		warn(("[LightingService] terrain colours not set for %s: %s"):format(table.concat(failed, ", "), lastErr))
	end
end

-- Canary: the engine sun must match the measured model (Look.Sun); publishes the angle as Lighting "SunModelError".
local function checkSunModel(hour: number)
	local dir = LightingService._sunDirection()
	if not dir then
		return
	end
	local x, y, z = LightingService.sunDirectionAt(hour, Lighting.GeographicLatitude)
	local dot = math.clamp(dir.X * x + dir.Y * y + dir.Z * z, -1, 1)
	local err = math.deg(math.acos(dot))
	Lighting:SetAttribute("SunModelError", math.floor(err * 100 + 0.5) / 100)
	if err > 1 then
		warn(
			("[LightingService] engine sun is %.1f deg off Look.Sun's model at %.2f h: re-measure (tools/look)"):format(
				err,
				hour
			)
		)
	end
end

---------------------------------------------------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------------------------------------------------

function LightingService.isNight(): boolean
	return night
end

function LightingService.getNightFactor(): number
	return nightFactor
end

function LightingService.isWet(): boolean
	return wet
end

function LightingService.getClockTime(): number
	return currentHour()
end

-- Number of registered lit windows and how many are on (tests, debug).
function LightingService.windowStats(): (number, number)
	local n, lit = 0, 0
	for part, st in windows do
		if part.Parent == nil then
			windows[part] = nil -- destroyed / unparented: drop
		else
			n += 1
			if st.on then
				lit += 1
			end
		end
	end
	return n, lit
end

-- Jump the cycle to an hour (admin/testing). Everything (look, sky, attributes, night state) updates immediately.
function LightingService.setClockTime(hour: number)
	cycleStart = os.clock() - LightingService.timeForHour(hour)
	applyAll(hour % 24, true)
end

-- One Sky / Atmosphere / effect of each managed class: adopt the place file's (Rojo-built) instance by name, else the
-- first of its class, destroy duplicates (Roblox renders one Sky/Atmosphere; post effects stack).
local function adopt(className: string, name: string): Instance
	local keep: Instance? = Lighting:FindFirstChild(name)
	if keep and not keep:IsA(className) then
		keep = nil
	end
	for _, c in Lighting:GetChildren() do
		if c:IsA(className) then
			if keep == nil then
				keep = c
			elseif c ~= keep then
				c:Destroy()
			end
		end
	end
	if keep == nil then
		local inst = Instance.new(className)
		inst.Name = name
		inst.Parent = Lighting
		keep = inst
	end
	return keep :: Instance
end

function LightingService.init()
	-- NOTE: no Lighting.Technology write (deprecated, RobloxScript-only): LightingStyle/PrioritizeLightingQuality live
	-- in default.project.json.
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GeographicLatitude = Look.Sun.latitude
	Lighting.FogEnd = 100000

	local s = adopt("Sky", "Sky") :: Sky
	s.SunAngularSize = Look.SkyStyle.sunAngularSize
	s.MoonAngularSize = Look.SkyStyle.moonAngularSize
	sky = s
	atmosphere = adopt("Atmosphere", "Atmosphere") :: Atmosphere
	bloom = adopt("BloomEffect", "Bloom") :: BloomEffect
	color = adopt("ColorCorrectionEffect", "ColorCorrection") :: ColorCorrectionEffect
	sunRays = adopt("SunRaysEffect", "SunRays") :: SunRaysEffect
	for _, c in Lighting:GetChildren() do
		-- depth of field / blur belong on the camera (menus, phone UI), never on the whole world
		if c:IsA("DepthOfFieldEffect") or c:IsA("BlurEffect") then
			c.Enabled = false
		end
	end

	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	clouds = nil
	if terrain then
		local ok = pcall(function()
			-- one Clouds only: adopt the one MapBuilder made (Terrain honours a single Clouds instance)
			local existing = terrain:FindFirstChildOfClass("Clouds")
			if existing then
				clouds = existing
			else
				local c = Instance.new("Clouds")
				c.Name = "HotwireClouds"
				c.Parent = terrain
				clouds = c
			end
		end)
		if not ok then
			warn("[LightingService] could not create clouds")
		end
		local okT, errT = pcall(applyTerrainLook, terrain)
		if not okT then
			warn("[LightingService] terrain look: " .. tostring(errT))
		end
	end

	table.clear(written) -- (re)adopted instances: the next apply writes everything
	currentSky = nil
	skyYawCurrent = nil
	skyYawWritten = nil
	windowNf = nil
	local hour = currentHour()
	nightFactor = LightingService.nightFactorAt(hour)
	night = nightFactor >= Look.Night.lightsOn
	Lighting:SetAttribute("IsNight", night)
	for _, inst in CollectionService:GetTagged(LightingService.TAG_LIT_WINDOW) do
		registerWindow(inst)
	end
	for _, inst in CollectionService:GetTagged(LightingService.TAG_NIGHT_GLOW) do
		if isAdoptedGlow(inst) then
			registerWindow(inst)
		end
	end
	applyAll(hour, false)
	applyNightState(night, false)
	applyWetStreets(nightFactor >= Look.WetStreets.nightFactor)
	checkSunModel(hour)

	if connected then
		return
	end
	connected = true
	-- late-tagged instances (e.g. garages built later) pick up the current state
	CollectionService:GetInstanceAddedSignal(LightingService.TAG_NIGHT_GLOW):Connect(function(inst: Instance)
		task.defer(function()
			if isAdoptedGlow(inst) then
				registerWindow(inst)
			else
				applyGlow(inst, night)
			end
		end)
	end)
	CollectionService:GetInstanceAddedSignal(LightingService.TAG_STREET_LIGHT):Connect(function(inst: Instance)
		task.defer(function()
			applyStreetLight(inst, night)
		end)
	end)
	CollectionService:GetInstanceAddedSignal(LightingService.TAG_LIT_WINDOW):Connect(function(inst: Instance)
		task.defer(registerWindow, inst)
	end)
	CollectionService:GetInstanceRemovedSignal(LightingService.TAG_LIT_WINDOW):Connect(unregisterWindow)
	CollectionService:GetInstanceRemovedSignal(LightingService.TAG_NIGHT_GLOW):Connect(function(inst: Instance)
		if not CollectionService:HasTag(inst, LightingService.TAG_LIT_WINDOW) then
			unregisterWindow(inst)
		end
	end)
end

function LightingService.start()
	local envAcc = 0
	while true do
		local dt = task.wait(Look.Cycle.clockInterval)
		local hour = currentHour()
		write(Lighting, "L.ClockTime", "ClockTime", hour, 0.0005)
		applySky(hour, dt) -- every tick: smooth yaw, cached writes
		envAcc += dt
		if envAcc >= Look.Cycle.envInterval then
			envAcc = 0
			applyLook(hour)
		end
		applyClockState(hour, true)
	end
end

return LightingService
