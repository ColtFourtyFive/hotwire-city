-- Any def by id, police units included (CarBuilder.build / previews).
function Cars.getAny(id: string): CarDef?
	if id == Cars.Police.id then
		return Cars.Police
	elseif id == Cars.PoliceSUV.id then
		return Cars.PoliceSUV
	end
	return Cars.get(id)
end

