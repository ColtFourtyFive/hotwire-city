--!strict
-- The car catalog (Cars v2, PLAN wave A4). Every car in the game is defined here.
--
-- v2: realistic parody cars. `vehicle` names the uploaded car Model in Config/Vehicles (CarBuilder v2 mounts it on the
-- arcade chassis); `brand` / `model` are our own parody names (never real brands, never GTA names); `class` is the
-- realistic class (LOOP_V2 §2.10: orders, sets). `style` is the v1 procedural look kept as the fallback while a
-- template loads or when it fails, so it stays one of the CarStyles CarBuilder can build.
-- Ids are STABLE: every v1 id with a realistic counterpart keeps its id and its v1 economy (rarity, income, price,
-- handling); the v1 meme / fantasy cars left the catalog and resolve through Config/CarAliases (Cars.get handles it).
-- Bands per rarity (LOOP_V2 §2.10): Common $3-7/s $120-400 · Uncommon $14-24/s $1-2.4K · Rare $55-75/s $7-11K ·
-- Epic $220-320/s $40-65K · Legendary $900-1300/s $250-400K · Mythic $4-6K/s $1.5-2.5M · Secret $20-40K/s $10-30M.
-- Income is $/second while parked in a garage slot (before multipliers).

local CarAliases = require(script.Parent.CarAliases)
local Rarity = require(script.Parent.Rarity)

export type CarStyle =
	"compact"
	| "sedan"
	| "taxi"
	| "van"
	| "pickup"
	| "muscle"
	| "sports"
	| "suv"
	| "limo"
	| "police"
	| "super"
	| "hyper"
	| "monster"
	| "armored"
	| "icecream"
	| "tank"
	| "hover"
	| "hotdog"
	| "duck"
	| "couch"
	| "toilet"
	| "rocket"

export type CarDef = {
	id: string,
	name: string, -- display name: "<brand> <model>" for v2 cars
	rarity: Rarity.RarityId,
	style: CarStyle, -- v1 procedural fallback look
	color: Color3, -- primary body color (factory paint)
	accent: Color3, -- secondary / trim
	income: number, -- $/sec base
	price: number, -- dealership price (also base sell value * 0.5)
	topSpeed: number, -- studs/sec
	accel: number, -- studs/sec^2
	grip: number, -- 0..1 lateral grip (1 = on rails)
	street: boolean, -- can spawn parked / in traffic
	dealer: boolean, -- can appear at the dealership
	stealable: boolean, -- can be stolen from another player's garage
	flavor: string, -- one-line description for the Index
	-- v2 (optional so ad-hoc defs and v1 tooling keep working)
	brand: string?, -- parody brand
	model: string?, -- model name
	class: string?, -- realistic class (Config/Vehicles class ids)
	vehicle: string?, -- Config/Vehicles id of the uploaded Model; nil = procedural only
	livery: boolean?, -- fixed service livery (police / taxi / ambulance...): no factory paint variety
	oversize: boolean?, -- too long for a garage pad (bus, fire truck): never offered as a delivery / display car
	police: boolean?, -- emergency lightbar is live (SirenRed / SirenBlue lit)
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

