--!strict
-- The car catalog. Every car in the game is defined here.
-- `style` selects the procedural body built by Shared/Vehicle/CarBuilder.
-- Income is $/second while parked in a garage slot (before multipliers).

local Rarity = require(script.Parent.Rarity)

export type CarStyle =
	"compact"
	| "sedan"
	| "taxi"
	| "van"
	| "pickup"
	| "muscle"
	| "sports"
	| "suv"
	| "limo"
	| "police"
	| "super"
	| "hyper"
	| "monster"
	| "armored"
	| "icecream"
	| "tank"
	| "hover"
	| "hotdog"
	| "duck"
	| "couch"
	| "toilet"
	| "rocket"

export type CarDef = {
	id: string,
	name: string,
	rarity: Rarity.RarityId,
	style: CarStyle,
	color: Color3, -- primary body color
	accent: Color3, -- stripes / trim / secondary
	income: number, -- $/sec base
	price: number, -- dealership price (also base sell value * 0.5)
	topSpeed: number, -- studs/sec
	accel: number, -- studs/sec^2
	grip: number, -- 0..1 lateral grip (1 = on rails)
	street: boolean, -- can spawn parked / in traffic
	dealer: boolean, -- can appear at the dealership
	stealable: boolean, -- can be stolen from another player's garage
	flavor: string, -- one-line description for the Index
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

