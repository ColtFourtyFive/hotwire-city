local Cars = {}
Cars.List = list
Cars.ById = {} :: { [string]: CarDef }
Cars.ByRarity = {} :: { [Rarity.RarityId]: { CarDef } }

for _, def in list do
	assert(Cars.ById[def.id] == nil, "Duplicate car id " .. def.id)
	Cars.ById[def.id] = def
	local bucket = Cars.ByRarity[def.rarity]
	if not bucket then
		bucket = {}
		Cars.ByRarity[def.rarity] = bucket
	end
	table.insert(bucket, def)
end

-- A catalog car by id; v1 ids that left the catalog resolve through Config/CarAliases.
function Cars.get(id: string): CarDef?
	return Cars.ById[id] or Cars.ById[CarAliases.Map[id] or ""]
end

