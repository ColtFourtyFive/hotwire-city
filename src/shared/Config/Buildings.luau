-- Fit tolerances: a template is only scaled within these (per axis), so facades never distort badly; a better-fitting
-- variant or a composite row is preferred. Width may shrink / grow a little to meet the frontage; depth may shrink
-- more (side facades); height follows the parcel's target height.
Buildings.Fit = {
	width = { 0.86, 1.14 },
	depth = { 0.72, 1.12 },
	height = { 0.85, 1.18 },
	anisotropy = 0.24, -- max |log(sx / sy)| (window proportions)
	gapPenalty = 2.0, -- per unit of unfilled frontage share (urban styles; elsewhere a quarter of this)
	heightWeight = 3.0,
	widthWeight = 2.0,
	depthWeight = 0.6,
	crownMismatch = 0.35, -- planned towers: kit crown differs from the parcel's
	variety = 0.25, -- deterministic per-parcel jitter added to scores (variety among near-equal fits)
	rowMinWidth = 38, -- composite row pieces are at least this wide
	rowMaxPiece = 84, -- frontage above this splits into several buildings (midtown / urban retail)
}

