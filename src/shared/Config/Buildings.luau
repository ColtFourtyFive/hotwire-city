--!strict
-- Config/Buildings: the v2 building set (PLAN wave A3). BuildingService dresses every WorldLayout parcel from it.
--
-- Templates (GENERATED block at the bottom, written by tools/blender/buildkit/gen_config.py from
-- assets/buildings/catalog.json + assets/buildings/manifest.json) are owned Model assets produced by the Blender
-- building kit (tools/blender/buildkit, variants.py): one MeshPart per material role, named "<key>_<part>". The
-- uploaded file carries geometry + UVs only; each part's surface is applied at runtime from `parts` below:
--   * tiling surfaces = Enum.Material + the place's global PBR MaterialVariants (Config/Look overrides; `var` names a
--     per-part variant such as HC_BrickTan) tinted by BasePart.Color (Look colour contract). MaterialVariants are
--     projected per face at StudsPerTile on MeshParts, so a scaled building keeps the same texel density;
--   * atlas surfaces (window interiors, shop signs, brands, awnings) = MeshPart.TextureID with the shared Images;
--   * WindowsLit = Neon, hidden by day, lit per building over dusk (Workspace attribute NightFactor);
--   * Neon = SmoothPlastic `rgb` by day, Material Neon `night.rgb` at night.
-- Template model space (verified with a probe upload): origin = lot bottom-centre at grade, front faces -Z, +Y up.
--
-- Pure data: no Roblox types (colours are { r, g, b } 0..255), so Lune tools and tests can read it.

export type RGB = { number }

export type PartDef = {
	name: string, -- part suffix: the MeshPart is named <template key>_<name>
	role: string, -- kit role (Walls, Walls2, Trim, Glass, Roof, Details, Neon, WindowsLit, ...)
	mat: string, -- Enum.Material name
	var: string?, -- per-part MaterialVariant (nil = the material's global override, if any)
	rgb: RGB,
	tex: string?, -- Buildings.Images key (MeshPart.TextureID)
	alpha: number?, -- Transparency
	refl: number?, -- Reflectance
	night: { mat: string, rgb: RGB? }?, -- night state (Neon parts / WindowsLit)
	tris: number,
}

export type Template = {
	key: string,
	family: string, -- tower | office | midtown | deco | retail | house | villa | mansion | industrial
	arch: string, -- kit archetype
	assetId: number, -- 0 = not uploaded (procedural fallback)
	size: { number }, -- { lot width X, height Y, lot depth Z } studs
	body: { number }, -- building box without the lot paving: { minX, minY, minZ, maxX, maxY, maxZ }
	baseDepth: number, -- how far the model reaches below grade (hillside plinth)
	floors: number?,
	crown: string?, -- towers: kit crown (mech | flat | spire | slant | stepped | helipad | lit_band)
	planned: boolean?, -- sized for the planned skyline (160 x 160 lots)
	tris: number,
	parts: { PartDef },
}

export type Finish = { mat: string, var: string?, rgb: RGB }

