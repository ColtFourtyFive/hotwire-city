-- Wall finishes. The colour contract: Part.Color multiplies the MaterialVariant's bright detail map, so these are the
-- albedos Look already uses (HC_BrickRed 177,141,124; HC_BrickTan 220,197,171; HC_Stucco near-white tinted).
local BRICK_RED: Finish = { mat = "Brick", rgb = { 177, 141, 124 } }
local BRICK_DARK: Finish = { mat = "Brick", rgb = { 150, 112, 98 } }
local BRICK_TAN: Finish = { mat = "Brick", var = "HC_BrickTan", rgb = { 220, 197, 171 } }
local function painted(r: number, g: number, b: number): Finish
	return { mat = "Brick", var = "HC_BrickTan", rgb = { r, g, b } }
end
local function stucco(r: number, g: number, b: number): Finish
	return { mat = "Plaster", rgb = { r, g, b } }
end
local function panel(mat: string, var: string?, r: number, g: number, b: number): Finish
	return { mat = mat, var = var, rgb = { r, g, b } }
end

