export type Aspect = "1:1" | "2:1" | "1:2" | "8:3" | "2:3" | "16:9"
export type Brand = {
	name: string,
	category: string,
	logo: string, -- 512x512 PNG with alpha
	colors: { Color3 }, -- primary first
	tagline: string,
	districts: { string },
	poiBrand: string?,
	station: string?, -- radio station name as used by Config/Sounds
	segment: string?, -- car makers: super / muscle / tuner
}
export type Billboard = { id: string, brand: string?, aspect: Aspect, image: string, copy: string }
export type Sign = {
	id: string,
	key: string,
	brand: string?,
	name: string,
	kind: "fascia" | "awning" | "painted" | "pylon",
	aspect: Aspect,
	image: string,
	districts: { string },
	poiBrand: string?,
	poi: string?,
	use: string?,
}
export type Poster = {
	id: string,
	kind: "flyer" | "poster" | "busstop",
	brand: string?,
	aspect: Aspect,
	image: string,
	title: string,
	districts: { string },
}
export type Graffiti = {
	id: string,
	kind: "tag" | "stencil" | "mural",
	aspect: Aspect,
	image: string,
	alpha: boolean,
	districts: { string },
}
export type Loading = { id: string, title: string, aspect: Aspect, image: string }

