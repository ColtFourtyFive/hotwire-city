-- 12. Parcels (lots): frontage subdivision of every street in built-up districts
-------------------------------------------------------------------------------------------------------------------------

export type Parcel = {
	id: number,
	district: string,
	use: string,
	cframe: CFrame, -- ground center (Y = street level at the frontage), LookVector faces the street
	size: Vector3, -- X frontage width, Y target height (0 = open lot), Z depth
	floors: number,
	edge: number,
	style: string,
	seed: number,
}

local Parcels: { Parcel } = {}

-- parcel spatial hash for overlap tests
local PCELL = 160
local parcelCells: { [number]: { number } } = {}
local parcelObbs: { WorldGen.OBB } = {}

local function obbBounds(b: WorldGen.OBB): (number, number, number, number)
	local r = math.sqrt(b.hw * b.hw + b.hd * b.hd)
	return b.cx - r, b.cz - r, b.cx + r, b.cz + r
end

local function overlapsAny(b: WorldGen.OBB, margin: number): boolean
	local x0, z0, x1, z1 = obbBounds(b)
	for cx = math.floor(x0 / PCELL), math.floor(x1 / PCELL) do
		for cz = math.floor(z0 / PCELL), math.floor(z1 / PCELL) do
			local list = parcelCells[WorldGen.cellKey(cx, cz)]
			if list then
				for _, id in list do
					if WorldGen.obbOverlap(b, parcelObbs[id], margin) then
						return true
					end
				end
			end
		end
	end
	return false
end

local function insertObb(b: WorldGen.OBB): number
	table.insert(parcelObbs, b)
	local id = #parcelObbs
	local x0, z0, x1, z1 = obbBounds(b)
	WorldGen.hashBox(parcelCells, PCELL, x0, z0, x1, z1, id)
	return id
end

for _, r in reserved do
	insertObb(r.obb)
end

