local function useWeights(uses: { { any } }, r: number): string
	local total = 0
	for _, u in uses do
		total += u[2]
	end
	local acc = 0
	for _, u in uses do
		acc += u[2] / total
		if r <= acc then
			return u[1]
		end
	end
	return uses[#uses][1]
end

