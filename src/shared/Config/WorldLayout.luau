	shop = 18,
	diner = 16,
	motel = 24,
	shed = 18,
	barn = 30,
	farmhouse = 24,
	gallery = 30,
	brewery = 34,
	nightclub = 34,
	mansion = 34,
	villa = 30,
	warehouse = 40,
	factory = 56,
	hangar = 50,
	parking_garage = 62,
}

local function parcelHeight(dist: DistrictDef, use: string, x: number, z: number, r: number): number
	if OPEN_USES[use] then
		return 0
	end
	local lowH = LOW_USES[use]
	if lowH then
		return math.floor(lowH * (0.85 + 0.4 * r))
	end
	local h0, h1 = dist.height[1], dist.height[2]
	local f = r
	if dist.peak then
		local d = WorldGen.dist(x, z, dist.peak[1], dist.peak[2])
		local near = 1 - math.clamp(d / dist.peak[3], 0, 1)
		f = math.clamp(near * near * (0.55 + 0.45 * r) + 0.12 * r, 0, 1)
	end
	if use == "hotel" or use == "beach_hotel" then
		f = math.max(f, 0.35)
	end
	return math.floor(h0 + (h1 - h0) * f)
end

local LOT_CLASSES: { [string]: boolean } = { boulevard = true, avenue = true, street = true, rural = true, highway = true }

do
	local seq = 0
	for ei, e in Edges do
		if not LOT_CLASSES[e.class] or e.layer ~= 0 or e.bridge then
			continue
		end
		local pts = edgePts[ei].pts
		for _, side in { 1, -1 } do
			local s = nodeRadius(e.a) + 10
			local sEnd = e.length - nodeRadius(e.b) - 10
			local k = 0
			while s < sEnd - 30 do
				k += 1
				local px, pz, tx, tz = WorldGen.polyAt(pts, s)
				local rx, rz = WorldGen.right(tx, tz)
				local nx, nz = rx * side, rz * side
				local probeX, probeZ = px + nx * (e.width / 2 + e.sidewalk + 40), pz + nz * (e.width / 2 + e.sidewalk + 40)
				local did = districtAt(probeX, probeZ)
				local dist = districtById[did]
				local rule = dist.lot
				local h1 = WorldGen.hash(ei * 2 + (if side > 0 then 1 else 0), k, 9001)
				local h2 = WorldGen.hash(ei, k, 9002 + side)
				local h3 = WorldGen.hash(ei, k, 9003 + side)
				local width = rule.width[1] + (rule.width[2] - rule.width[1]) * h1
				if s + width > sEnd then
					width = sEnd - s
					if width < rule.width[1] * 0.75 then
						break
					end
				end
				local cs = s + width / 2
				px, pz, tx, tz = WorldGen.polyAt(pts, cs)
				local py = WorldGen.polyYAt(pts, cs)
				rx, rz = WorldGen.right(tx, tz)
				nx, nz = rx * side, rz * side
				if h2 > rule.density then
					s += width + 4
					continue
				end
				local setback = rule.setback[1] + (rule.setback[2] - rule.setback[1]) * h3
				local front = e.width / 2 + e.sidewalk + setback
				local placed = false
				for _, depthF in { 1, 0.75, 0.55 } do
					local depth = (rule.depth[1] + (rule.depth[2] - rule.depth[1]) * h2) * depthF
					local cx, cz = px + nx * (front + depth / 2), pz + nz * (front + depth / 2)
					local obb: WorldGen.OBB = { cx = cx, cz = cz, ux = tx, uz = tz, hw = width / 2 - 2, hd = depth / 2 }
					-- checks: district consistent, on land, not in reserved areas, clear of roads and other lots
					local ok = districtAt(cx, cz) == did
					if ok then
						for _, c in WorldGen.obbCorners(obb) do
							local sd = shore(c.x, c.z)
							if sd < 40 then
								ok = false
								break
							end
							for _, area in NO_LOTS do
								if WorldGen.pointInPoly(area, c.x, c.z) then
									ok = false
									break
								end
							end
							if not ok then
								break
							end
							if roadClearance(c.x, c.z, 2) then
								ok = false
								break
							end
						end
					end
					if ok then
						-- edge midpoints + center against roads
						local probes = {
							{ x = cx, z = cz },
							{ x = cx - nx * depth / 2, z = cz - nz * depth / 2 },
							{ x = cx + nx * depth / 2, z = cz + nz * depth / 2 },
							{ x = cx + tx * width / 2, z = cz + tz * width / 2 },
							{ x = cx - tx * width / 2, z = cz - tz * width / 2 },
						}
						for _, pr in probes do
							if roadClearance(pr.x, pr.z, 2) then
								ok = false
								break
							end
						end
					end
					if ok and overlapsAny(obb, 3) then
						ok = false
					end
					if ok then
						-- slope check (hills terrace at most ~45 studs across a lot)
						local ys = {}
						for _, c in WorldGen.obbCorners(obb) do
							table.insert(ys, gradeAt(c.x, c.z))
						end
						local mn, mx = math.min(table.unpack(ys)), math.max(table.unpack(ys))
						if mx - mn > 46 then
							ok = false
						end
					end
					if ok then
						seq += 1
						local use = useWeights(rule.uses, WorldGen.hash(seq, ei, 77))
						local hr = WorldGen.hash(seq, 5, 78)
						local height = parcelHeight(dist, use, cx, cz, hr)
						local center = Vector3.new(cx, py, cz)
						local look = Vector3.new(-nx, 0, -nz)
						insertObb(obb)
						table.insert(Parcels, {
							id = #Parcels + 1,
							district = did,
							use = use,
							cframe = CFrame.lookAt(center, center + look),
							size = Vector3.new(width - 4, height, depth),
							floors = if height > 0 then math.max(1, math.floor(height / S.STOREY)) else 0,
							edge = ei,
							style = dist.style,
							seed = math.floor(WorldGen.hash(seq, 3, 79) * 2 ^ 31),
						})
						placed = true
						break
					end
				end
				local _ = placed
				s += width + 4
			end
		end
	end
end

-- Port container yards + warehouses (grid inside the terminal), airport hangars along Hangar Road.
do
	local seq = #Parcels
	local function add(did: string, use: string, x: number, z: number, w: number, d: number, h: number, yaw: number)
		local center = Vector3.new(x, gradeAt(x, z), z)
		local cf = CFrame.new(center) * CFrame.Angles(0, math.rad(yaw), 0)
		local ux, uz = cf.RightVector.X, cf.RightVector.Z
		local obb: WorldGen.OBB = { cx = x, cz = z, ux = ux, uz = uz, hw = w / 2, hd = d / 2 }
		for _, c in WorldGen.obbCorners(obb) do
			if roadClearance(c.x, c.z, 2) or shore(c.x, c.z) < 30 then
				return
			end
		end
		if roadClearance(x, z, 2) or overlapsAny(obb, 3) then
			return
		end
		insertObb(obb)
		seq += 1
		table.insert(Parcels, {
			id = #Parcels + 1,
			district = did,
			use = use,
			cframe = cf,
			size = Vector3.new(w, h, d),
			floors = if h > 0 then math.max(1, math.floor(h / S.STOREY)) else 0,
			edge = 0,
			style = districtById[did].style,
			seed = math.floor(WorldGen.hash(seq, 4, 80) * 2 ^ 31),
		})
	end
	for _, row in { 3780, 4180 } do
		local x = -1450
		while x < 2550 do
			local r = WorldGen.hash(x, row, 81)
			local w = 220 + 100 * r
			local use = if r < 0.62 then "container_yard" elseif r < 0.88 then "warehouse" else "shed"
			add("port", use, x + w / 2, row, w - 24, 260, if use == "container_yard" then 0 else 44, 0)
			x += w
		end
	end
	for i = 0, 5 do
		add("airport", "hangar", -3780 + i * 190, 2560 + i * 70, 150, 130, 52, -20)
	end
	add("airport", "parking_garage", -3700, 2520, 260, 160, 48, 0)
	add("airport", "parking_lot", -4300, 2520, 300, 160, 0, 0)
end

WorldLayout.Parcels = Parcels

