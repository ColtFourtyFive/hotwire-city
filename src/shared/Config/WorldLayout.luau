local SMOOTH = WorldGen.smoothstep

-- Height of the island before shoreline shaping (hills, desert, canyon).
local function inlandHeight(x: number, z: number): number
	local h = GRADE
	-- Sunwood Hills: rises north of the hill foot (z ~ -2000) to the crest (z ~ -3050), then a plateau toward the coast
	if x < 2600 and z < -1900 then
		local crest = crestAt(x)
		local foot = -1980 + 70 * math.sin(x / 700)
		local ridge = -3050 + 120 * math.sin(x / 900 + 1.3)
		local up = SMOOTH(foot, ridge, z)
		local down = 1 - 0.45 * SMOOTH(ridge, -4100, z)
		local edge = SMOOTH(2600, 1800, x) -- fades into the foothills east of the channel
		local base = crest * up * down
		local rough = (WorldGen.noise2(x, z, 420, 11) * 0.65 + WorldGen.noise2(x, z, 170, 12) * 0.35) * 34 * up
		h += math.max(0, base + rough) * edge
	end
	-- Red Mesa foothills (north-east)
	if x > 1500 and z < -1500 then
		local w = SMOOTH(1500, 2300, x) * SMOOTH(-1500, -2300, z)
		local f = 70 + 55 * WorldGen.noise2(x, z, 650, 21) + 22 * WorldGen.noise2(x, z, 230, 22)
		h = math.max(h, GRADE + math.max(0, f) * w)
	end
	-- Desert floor east (gentle dunes + rise toward the east coast)
	if x > 3000 then
		local w = SMOOTH(3000, 3700, x)
		local dunes = 8 * WorldGen.noise2(x, z, 260, 31) + 5 * WorldGen.noise2(x, z, 90, 32)
		local rise = 14 * SMOOTH(3400, 5600, x)
		h = math.max(h, GRADE + (math.max(0, dunes) + rise) * w)
	end
	-- Mesas
	for _, m in MESAS do
		local d = WorldGen.dist(x, z, m[1], m[2])
		if d < m[3] + 140 then
			local top = GRADE + m[4] + 6 * WorldGen.noise2(x, z, 60, 41)
			local t = SMOOTH(m[3] + 140, m[3], d)
			h = math.max(h, h + (top - h) * t * t)
		end
	end
	-- Sunwood Canyon (H9): a valley whose floor climbs gently to the pass and falls to Hidden Cove
	do
		local d, s = WorldGen.polyProject(CANYON_AXIS, x, z)
		if d < 520 then
			local L = WorldGen.polyLength(CANYON_AXIS)
			local pass = 0.72 * L
			local floorY = if s < pass
				then GRADE + 46 * SMOOTH(450, pass, s)
				else GRADE + 46 - 38 * SMOOTH(pass, L + 250, s)
			local v = SMOOTH(110, 520, d)
			if h > floorY then
				h = floorY + (h - floorY) * v
			end
		end
	end
	-- Flatten zones
	for _, f in FLATTEN do
		local sd = WorldGen.polySigned(f.poly, x, z)
		if sd > -f.blend then
			local t = SMOOTH(-f.blend, 0, sd)
			h = h + (f.y - h) * t
		end
	end
	return h
end

local COAST_BAND: { [string]: number } = { beach = 300, rock = 140, cliff = 55, quay = 4 }
local SHORE_Y: { [string]: number } = { beach = 0.8, rock = 1.5, cliff = 2.5, quay = GRADE }

-- Signed distance to the nearest landmass (positive on land) and the kind of the nearest coast segment.
local function shore(x: number, z: number): (number, CoastKind)
	local d1, i1 = WorldGen.polySigned(coastPoly, x, z)
	local d2, i2 = WorldGen.polySigned(islandPoly, x, z)
	if d2 > d1 then
		return d2, WorldLayout.Islands[1].points[i2].kind
	end
	return d1, WorldLayout.Coast[i1].kind
end

local function inWater(x: number, z: number): (boolean, number)
	for _, w in WorldLayout.Water do
		if WorldGen.pointInPoly(w.points, x, z) then
			return true, w.level
		end
	end
	return false, 0
end

-- Smooth ground grade (shoreline + hills, no channel / reservoir carve): what roads and lots sit on.
local function gradeAt(x: number, z: number): number
	local d, kind = shore(x, z)
	if d <= 0 then
		-- seabed
		if kind == "quay" then
			return -26
		elseif kind == "beach" then
			return math.max(-46, SHORE_Y.beach - 0.035 * (-d) - 0.6)
		end
		return math.max(-64, 1 - 0.18 * (-d) - 3)
	end
	local inland = inlandHeight(x, z)
	local band = COAST_BAND[kind]
	if d >= band then
		return inland
	end
	local t = SMOOTH(0, band, d)
	return SHORE_Y[kind] + (inland - SHORE_Y[kind]) * t
end

-- Terrain surface: grade with the Rust River channel and the reservoir carved in.
local function heightAt(x: number, z: number): number
	local h = gradeAt(x, z)
	local ch = WorldLayout.Channel
	local d, s = WorldGen.polyProject(ch.points, x, z)
	local half = ch.floorHalfWidth + ch.wallRun
	if d < half + 40 then
		local L = WorldGen.polyLength(ch.points)
		local floorY = ch.floorNorthY + (ch.floorSouthY - ch.floorNorthY) * (s / L)
		local _, cz = WorldGen.polyAt(ch.points, s)
		if cz < ch.startOpenAt then
			-- natural creek in the foothills: a softer, wider cut
			local creekY = math.max(floorY, h - 18)
			local t = SMOOTH(half + 40, ch.floorHalfWidth * 0.5, d)
			h = h + (creekY - h) * t
		elseif d <= ch.floorHalfWidth then
			h = math.min(h, floorY)
		elseif d <= half then
			h = math.min(h, floorY + (GRADE - floorY) * (d - ch.floorHalfWidth) / ch.wallRun)
		end
	end
	local wet, level = inWater(x, z)
	if wet then
		local sd = WorldGen.polySigned(WorldLayout.Water[1].points :: any, x, z)
		h = math.min(h, level - 2 - math.min(26, sd * 0.12))
	end
	return h
end

WorldLayout.gradeAt = gradeAt
WorldLayout.heightAt = heightAt

