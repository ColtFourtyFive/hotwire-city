-- Plots (8 player garages): one per district around the core, each 1-2 blocks from a freeway ramp.
type PlotDef = { name: string, at: { number }, road: string? }
local PLOT_DEFS: { PlotDef } = {
	{ name = "Palmera Garage", at = { -3960, -120 } },
	{ name = "Sunwood Garage", at = { -2100, -2250 }, road = "Sunwood Boulevard" },
	{ name = "Pinnacle Garage", at = { 650, -1430 } },
	{ name = "Foundry Garage", at = { 2700, -950 } },
	{ name = "Rust Flats Garage", at = { 2700, 900 } },
	{ name = "Southgate East Garage", at = { 1150, 1900 } },
	{ name = "Southgate West Garage", at = { -1750, 2100 } },
	{ name = "Midtown Garage", at = { -3000, 1000 } },
}
local PLOT_W, PLOT_D = 140, 150 -- reserved garage footprint (frontage x depth)

local Plots: { Plot } = {}

-- Plots first (they get the best frontages), then POIs.
for i, def in PLOT_DEFS do
	local cf, entrance, ei, obb = placeOnFrontage(def.at[1], def.at[2], PLOT_W, PLOT_D, {
		setback = 14,
		road = def.road,
		classes = { street = true, avenue = true, boulevard = true },
	})
	assert(cf and obb, "plot " .. def.name .. " found no frontage")
	local e = Edges[ei]
	local look = cf.LookVector
	-- door = middle of the front face; curb spot = right-hand curb just past the driveway, facing along traffic
	local door = cf.Position + look * (PLOT_D / 2)
	local rightOfStreet = Vector3.new(-look.Z, 0, look.X) -- travel direction whose right side is the plot
	-- curb lane center: entrance (curb) minus PARKING_LANE / 2 toward the road
	local spot = entrance + look * (S.PARKING_LANE / 2 + 0.5) - rightOfStreet * (PLOT_W / 2 + 14)
	local _ = e
	table.insert(Plots, {
		index = i,
		name = def.name,
		district = districtAt(cf.Position.X, cf.Position.Z),
		cframe = cf,
		size = Vector3.new(PLOT_W, 40, PLOT_D),
		door = door,
		curbSpot = CFrame.lookAt(spot, spot + rightOfStreet),
		edge = ei,
		nearestOnRamp = 0, -- filled below
	})
	table.insert(reserved, { obb = obb, what = "plot" .. i })
end

for _, def in POI_DEFS do
	addPOI(def)
end

-- On-ramp terminals (ground end of every on-ramp) for the plots' escape-route metric.
local onRampTerminals: { Vector3 } = {}
for _, e in Edges do
	if e.class == "ramp" and e.points[1].Y <= GRADE + 1 then
		table.insert(onRampTerminals, e.points[1])
	end
end
for _, plot in Plots do
	local best = math.huge
	for _, p in onRampTerminals do
		best = math.min(best, (Vector3.new(p.X, 0, p.Z) - Vector3.new(plot.door.X, 0, plot.door.Z)).Magnitude)
	end
	plot.nearestOnRamp = best
end

WorldLayout.POIs = POIs
WorldLayout.Plots = Plots

