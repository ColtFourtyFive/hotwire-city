local RING_CTRL: { P2 } = {
	P(-1000, -1800),
	P(1650, -1800),
	P(1650, 1350),
	P(-3650, 1350),
	P(-3650, -1800),
	P(-1000, -1800),
}
local ringCenter = WorldGen.fillet(RING_CTRL, 600, nil, 40)
local H1 = corridor("H1 Ring Freeway", ringCenter, 3, { "(clockwise)", "(counter-clockwise)" })

-- H2 Port Expressway: south from the ring over Southgate and the Iron Bay Bridge onto the port island.
local H2center: { P2 } = { P(700, 1350), P(700, 1950), P(700, 2600), P(700, 3000), P(700, 3420), P(700, 3800), P(700, 4020) }
local H2 = trumpet("H2 Port Expressway", H1, H2center, 2, { "(southbound)", "(northbound)" })
do
	-- profile: deck over Southgate, arching to 66 over the channel, descending to grade on the island
	local L = WorldGen.polyLength(H2.center)
	local function prof(s: number): number
		local _, z = WorldGen.polyAt(H2.center, s)
		if z < 2900 then
			return DECK_Y
		elseif z < 3220 then
			return DECK_Y + 26 * SMOOTH(2900, 3220, z)
		elseif z < 3480 then
			return DECK_Y + 26 * (1 - SMOOTH(3220, 3480, z))
		end
		return DECK_Y + (GRADE - DECK_Y) * SMOOTH(3480, 3880, z)
	end
	local _ = L
	for _, w in { H2.fwd, H2.bwd } do
		w.yMode = "profile"
		local wp = w
		wp.profile = function(s: number, Lw: number): number
			local x, z = WorldGen.polyAt(wp.pts, s)
			local _, sc = WorldGen.polyProject(H2.center, x, z)
			local _ = Lw
			return prof(sc)
		end
	end
end
local H2end = corridorTail(H2, 160, "H2 Port Expressway", "highway", { lanes = 2, median = 6, yMode = "ground" })

-- H9: Sunwood Canyon freeway north from the ring to the Coast Highway at Hidden Cove.
local H9center: { P2 } = WorldGen.fillet({
	P(-2600, -1800),
	P(-2600, -2330),
	P(-2720, -2800),
	P(-2900, -3250),
	P(-2960, -3640),
}, 500, nil, 40)
local H9 = trumpet("H9 Sunwood Freeway", H1, H9center, 2, { "(northbound)", "(southbound)" })
do
	-- deck near the ring, then down into the canyon floor (ground-following, grade-limited)
	for _, w in { H9.fwd, H9.bwd } do
		w.yMode = "ground"
		w.maxGrade = 0.065
		local wp = w
		wp.minProfile = function(s: number, Lw: number): number
			local x, z = WorldGen.polyAt(wp.pts, s)
			local _ = x
			local _ = Lw
			-- deck until z -2150, then a 7% descent
			local d = math.max(0, -2150 - z)
			return math.max(GRADE, DECK_Y - d * 0.07)
		end
	end
end
local H9end = corridorTail(H9, 170, "H9 Sunwood Freeway", "highway", { lanes = 2, median = 6, yMode = "ground" })

