export type ParkingSpot = { cframe: CFrame, edge: number, district: string, tier: string }
export type PoliceSpawn = { cframe: CFrame, station: string, edge: number }
export type TrafficEdge = { edge: number, weight: number }

local parking: { ParkingSpot } = {}
do
	local avoid: { Vector3 } = {}
	for _, p in POIs do
		table.insert(avoid, p.entrance)
	end
	for _, p in Plots do
		table.insert(avoid, p.door)
	end
	for ei, e in Edges do
		if not e.parking or e.layer ~= 0 or e.bridge then
			continue
		end
		local pts = edgePts[ei].pts
		local s0 = nodeRadius(e.a) + 26
		local s1 = e.length - nodeRadius(e.b) - 26
		local laneSide = e.width / 2 - S.PARKING_LANE / 2
		local k = 0
		local s = s0
		while s <= s1 do
			k += 1
			local px, pz, tx, tz = WorldGen.polyAt(pts, s)
			local py = WorldGen.polyYAt(pts, s)
			local rx, rz = WorldGen.right(tx, tz)
			for _, side in { 1, -1 } do
				-- right side faces along a->b; left side along b->a (one-way: both curbs face a->b)
				local fx, fz = tx, tz
				if side < 0 and not e.oneWay then
					fx, fz = -tx, -tz
				end
				local pos = Vector3.new(px + rx * laneSide * side, py, pz + rz * laneSide * side)
				local clear = true
				for _, a in avoid do
					if (Vector3.new(a.X, 0, a.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude < 34 then
						clear = false
						break
					end
				end
				if clear and WorldGen.hash(ei, k, if side > 0 then 31 else 32) < 0.86 then
					local did = districtAt(pos.X, pos.Z)
					table.insert(parking, {
						cframe = CFrame.lookAt(pos, pos + Vector3.new(fx, 0, fz)),
						edge = ei,
						district = did,
						tier = districtById[did].carTier,
					})
				end
			end
			s += S.PARKING_SPACING
		end
	end
end

local police: { PoliceSpawn } = {}
for _, p in POIs do
	if p.kind == "police" then
		local e = Edges[p.edge]
		local pts = edgePts[p.edge].pts
		local _, s = WorldGen.polyProject(pts, p.entrance.X, p.entrance.Z)
		for _, ds in { -70, 70, -140, 140 } do
			local ss = math.clamp(s + ds, 10, e.length - 10)
			for _, dir in (if e.oneWay then { 1 } else { 1, -1 }) :: { number } do
				local px, pz, tx, tz = WorldGen.polyAt(pts, ss)
				local py = WorldGen.polyYAt(pts, ss)
				local fx, fz = tx * dir, tz * dir
				local rx, rz = WorldGen.right(fx, fz)
				local off = if e.oneWay
					then (e.lanesF * LANE) / 2 - LANE / 2
					else e.median / 2 + (e.lanesF - 0.5) * LANE
				local pos = Vector3.new(px + rx * off, py, pz + rz * off)
				table.insert(police, { cframe = CFrame.lookAt(pos, pos + Vector3.new(fx, 0, fz)), station = p.id, edge = p.edge })
			end
		end
	end
end

local trafficEdges: { TrafficEdge } = {}
for ei, e in Edges do
	if e.traffic then
		table.insert(trafficEdges, { edge = ei, weight = e.length * (e.lanesF + e.lanesB) })
	end
end

local hospitalRespawns: { CFrame } = {}
for _, p in POIs do
	if p.kind == "hospital" then
		local look = p.cframe.LookVector
		local pos = p.entrance - look * 0 + Vector3.new(0, S.CURB_HEIGHT, 0) - look * (-(Edges[p.edge].sidewalk / 2))
		table.insert(hospitalRespawns, CFrame.lookAt(pos, pos + look))
	end
end

local plaza = poiById.HotwirePlaza
WorldLayout.Spawns = {
	parking = parking,
	police = police,
	traffic = trafficEdges,
	hospital = hospitalRespawns,
	default = if plaza then plaza.cframe + Vector3.new(0, 3, 0) else CFrame.new(0, GRADE + 3, 0),
	bustedRelease = (function(): CFrame
		local hq = poiById.PoliceHQ
		if hq then
			local pos = hq.entrance + Vector3.new(0, 3, 0) - hq.cframe.LookVector * -6
			return CFrame.lookAt(pos, pos + hq.cframe.LookVector)
		end
		return CFrame.new(0, GRADE + 3, 0)
	end)(),
}

