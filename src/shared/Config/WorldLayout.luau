-- 10. POIs, plots, landmarks (placed by "address": nearest frontage of an allowed road class)
-------------------------------------------------------------------------------------------------------------------------

export type POI = {
	id: string,
	name: string,
	kind: string,
	brand: string?,
	district: string,
	cframe: CFrame, -- footprint center at ground; LookVector faces the street (front door side)
	size: Vector3, -- X frontage width, Y height, Z depth
	entrance: Vector3, -- curb point in front of the door
	edge: number, -- frontage edge
	tags: { string },
}

export type Plot = {
	index: number,
	name: string,
	district: string,
	cframe: CFrame, -- origin for Garage local offsets: ground center of the garage, LookVector out of the door
	size: Vector3, -- reserved footprint (garage building + apron)
	door: Vector3,
	curbSpot: CFrame, -- right-hand curb spot just past the driveway (newbie car)
	edge: number,
	nearestOnRamp: number, -- studs (straight-line) to the closest freeway on-ramp terminal
}

type Reserved = { obb: WorldGen.OBB, what: string }
local reserved: { Reserved } = {}

local FRONTAGE_CLASSES: { [string]: boolean } = { boulevard = true, avenue = true, street = true, rural = true, highway = true }

type PlaceOpts = { classes: { [string]: boolean }?, setback: number?, side: number?, road: string? }

-- Place a w x d footprint fronting the road nearest (x, z). Returns cframe, entrance, edge, obb (or nil).
local function placeOnFrontage(x: number, z: number, w: number, d: number, o: PlaceOpts?): (CFrame?, Vector3, number, WorldGen.OBB?)
	local opts: PlaceOpts = o or {}
	local classes = opts.classes or FRONTAGE_CLASSES
	local ei = WorldGen.nearestEdge(edgeIndex, x, z, 900, function(i: number): boolean
		local e = Edges[i]
		return classes[e.class] == true and e.layer == 0 and not e.bridge and (opts.road == nil or e.name == opts.road)
	end)
	if ei == nil then
		return nil, Vector3.zero, 0, nil
	end
	local e = Edges[ei]
	local pts = edgePts[ei].pts
	local _, s = WorldGen.polyProject(pts, x, z)
	-- keep clear of the junctions at both ends
	local ra = nodeRadius(e.a) + w / 2 + 12
	local rb = nodeRadius(e.b) + w / 2 + 12
	if e.length > ra + rb then
		s = math.clamp(s, ra, e.length - rb)
	else
		s = e.length / 2
	end
	local px, pz, tx, tz = WorldGen.polyAt(pts, s)
	local py = WorldGen.polyYAt(pts, s)
	local rx, rz = WorldGen.right(tx, tz)
	local side = opts.side or (if (x - px) * rx + (z - pz) * rz >= 0 then 1 else -1)
	local nx, nz = rx * side, rz * side
	local setback = opts.setback or 6
	local curb = e.width / 2
	local frontDist = curb + e.sidewalk + setback
	local cx, cz = px + nx * (frontDist + d / 2), pz + nz * (frontDist + d / 2)
	local center = Vector3.new(cx, py, cz)
	local look = Vector3.new(-nx, 0, -nz)
	local cf = CFrame.lookAt(center, center + look)
	local entrance = Vector3.new(px + nx * curb, py, pz + nz * curb)
	-- OBB: width axis = road tangent
	local obb: WorldGen.OBB = { cx = cx, cz = cz, ux = tx, uz = tz, hw = w / 2, hd = d / 2 }
	return cf, entrance, ei, obb
end

local POIs: { POI } = {}
local poiById: { [string]: POI } = {}

type PoiDef = {
	id: string,
	name: string,
	kind: string,
	brand: string?,
	at: { number }, -- approximate x, z
	size: { number }, -- w, h, d
	setback: number?,
	road: string?, -- front on this road (name) if given
	tags: { string }?,
}

local function addPOI(def: PoiDef): POI?
	local cf, entrance, ei, obb =
		placeOnFrontage(def.at[1], def.at[2], def.size[1], def.size[3], { setback = def.setback, road = def.road })
	if not cf or not obb then
		return nil
	end
	local poi: POI = {
		id = def.id,
		name = def.name,
		kind = def.kind,
		brand = def.brand,
		district = districtAt(cf.Position.X, cf.Position.Z),
		cframe = cf,
		size = Vector3.new(def.size[1], def.size[2], def.size[3]),
		entrance = entrance,
		edge = ei,
		tags = def.tags or {},
	}
	table.insert(POIs, poi)
	poiById[def.id] = poi
	table.insert(reserved, { obb = obb, what = def.id })
	return poi
end

