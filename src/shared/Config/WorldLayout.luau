local arcs = WorldGen.arcs(#Nodes, Edges, function(i: number): boolean
	return Edges[i].oneWay
end)
local trafficArcs = WorldGen.arcs(#Nodes, Edges, function(i: number): boolean
	return Edges[i].oneWay
end, function(i: number): boolean
	return Edges[i].traffic
end)

local function nodePos(i: number): (number, number)
	local p = Nodes[i].pos
	return p.X, p.Z
end

local function nearestNodeTo(x: number, z: number, usable: ((Edge) -> boolean)?): number
	local ei = WorldGen.nearestEdge(edgeIndex, x, z, 3000, function(i: number): boolean
		return usable == nil or usable(Edges[i])
	end)
	assert(ei, "no road near " .. x .. "," .. z)
	local e = Edges[ei]
	local pa, pb = Nodes[e.a].pos, Nodes[e.b].pos
	local da = (pa.X - x) ^ 2 + (pa.Z - z) ^ 2
	local db = (pb.X - x) ^ 2 + (pb.Z - z) ^ 2
	return if da <= db then e.a else e.b
end

-- Polyline of a node path (signed edge ids from astar).
local function pathPoints(path: { number }): { Vector3 }
	local out: { Vector3 } = {}
	for _, signed in path do
		local e = Edges[math.abs(signed)]
		local pts = e.points
		if signed > 0 then
			for k = (if #out == 0 then 1 else 2), #pts do
				table.insert(out, pts[k])
			end
		else
			for k = (if #out == 0 then #pts else #pts - 1), 1, -1 do
				table.insert(out, pts[k])
			end
		end
	end
	return out
end

local function routeThrough(stops: { Vector3 }, useArcs: { { WorldGen.Arc } }, usable: ((Edge) -> boolean)?): ({ Vector3 }, number)
	local all: { Vector3 } = {}
	local total = 0
	for i = 1, #stops - 1 do
		local a = nearestNodeTo(stops[i].X, stops[i].Z, usable)
		local b = nearestNodeTo(stops[i + 1].X, stops[i + 1].Z, usable)
		local path, cost = WorldGen.astar(#Nodes, useArcs, nodePos, a, b)
		assert(path, "route: no path between stops " .. i .. " and " .. (i + 1))
		total += cost
		local pts = pathPoints(path)
		for k, p in pts do
			if #all == 0 or k > 1 then
				table.insert(all, p)
			end
		end
	end
	return all, total
end

export type Route = { id: string, name: string, kind: string, stops: { Vector3 }, path: { Vector3 }, length: number, laps: number }

local Routes: { Route } = {}
local function poiStop(id: string): Vector3
	local p = poiById[id]
	assert(p, "missing POI " .. id)
	return p.entrance
end

local function addRoute(id: string, name: string, kind: string, stops: { Vector3 }, laps: number, usable: ((Edge) -> boolean)?)
	local useArcs = if usable then WorldGen.arcs(#Nodes, Edges, function(i: number): boolean
		return Edges[i].oneWay
	end, function(i: number): boolean
		return usable(Edges[i])
	end) else trafficArcs
	local path, length = routeThrough(stops, useArcs, usable)
	table.insert(Routes, { id = id, name = name, kind = kind, stops = stops, path = path, length = length, laps = laps })
end

