-------------------------------------------------------------------------------------------------------------------------
-- 4. Road ways (authored + generated) -> graph
-------------------------------------------------------------------------------------------------------------------------

export type RoadClass =
	"freeway"
	| "ramp"
	| "highway"
	| "rural"
	| "boulevard"
	| "avenue"
	| "street"
	| "alley"
	| "dirt"
	| "pier"
	| "channel"
	| "runway"
	| "service"

type YMode = "ground" | "deck" | "ramp" | "profile" | "fixed"

type Way = {
	id: number,
	name: string,
	class: RoadClass,
	pts: { P2 },
	lanes: number, -- per direction (one-way: total)
	oneWay: boolean,
	median: number,
	parking: boolean,
	sidewalk: number,
	shoulder: number,
	speed: number,
	layer: number,
	noCross: boolean,
	keepDeadEnd: boolean,
	traffic: boolean,
	corridor: string?,
	generated: boolean,
	district: string?,
	-- vertical
	yMode: YMode,
	y0: number?,
	y1: number?,
	fixedY: number?,
	profile: ((s: number, L: number) -> number)?,
	minProfile: ((s: number, L: number) -> number)?, -- ground mode: never below this (freeway descending into a canyon)
	maxGrade: number,
	bridges: { { number } }?, -- arc-length spans flown over (Y linear between the span ends)
	ys: { number }?, -- computed per point
}

local ways: { Way } = {}

local CLASS_DEFAULTS: { [string]: { lanes: number, median: number, parking: boolean, sidewalk: number, shoulder: number, grade: number } } =
	{
		freeway = { lanes = 3, median = 0, parking = false, sidewalk = 0, shoulder = 0, grade = 0.07 },
		ramp = { lanes = 1, median = 0, parking = false, sidewalk = 0, shoulder = 3, grade = 0.08 },
		highway = { lanes = 2, median = 16, parking = false, sidewalk = 0, shoulder = 7, grade = 0.08 },
		rural = { lanes = 1, median = 0, parking = false, sidewalk = 0, shoulder = 5, grade = 0.11 },
		boulevard = { lanes = 3, median = 12, parking = false, sidewalk = 14, shoulder = 0, grade = 0.08 },
		avenue = { lanes = 2, median = 10, parking = true, sidewalk = 13, shoulder = 0, grade = 0.1 },
		street = { lanes = 1, median = 0, parking = true, sidewalk = 12, shoulder = 0, grade = 0.13 },
		alley = { lanes = 1, median = 0, parking = false, sidewalk = 0, shoulder = 0, grade = 0.14 },
		dirt = { lanes = 1, median = 0, parking = false, sidewalk = 0, shoulder = 2, grade = 0.14 },
		pier = { lanes = 1, median = 0, parking = false, sidewalk = 10, shoulder = 0, grade = 0.05 },
		channel = { lanes = 2, median = 0, parking = false, sidewalk = 0, shoulder = 10, grade = 0.05 },
		runway = { lanes = 2, median = 0, parking = false, sidewalk = 0, shoulder = 25, grade = 0.02 },
		service = { lanes = 1, median = 0, parking = false, sidewalk = 0, shoulder = 2, grade = 0.12 },
	}

type WayOpts = {
	lanes: number?,
	oneWay: boolean?,
	median: number?,
	parking: boolean?,
	sidewalk: number?,
	shoulder: number?,
	speed: number?,
	layer: number?,
	noCross: boolean?,
	keepDeadEnd: boolean?,
	traffic: boolean?,
	corridor: string?,
	generated: boolean?,
	district: string?,
	yMode: YMode?,
	y0: number?,
	y1: number?,
	fixedY: number?,
	profile: ((s: number, L: number) -> number)?,
	minProfile: ((s: number, L: number) -> number)?,
	maxGrade: number?,
	bridges: { { number } }?,
}

local function addWay(name: string, class: RoadClass, pts: { P2 }, o: WayOpts?): Way
	local opts: WayOpts = o or {}
	local def = CLASS_DEFAULTS[class]
	local w: Way = {
		id = #ways + 1,
		name = name,
		class = class,
		pts = pts,
		lanes = opts.lanes or def.lanes,
		oneWay = opts.oneWay == true,
		median = opts.median or def.median,
		parking = if opts.parking ~= nil then opts.parking else def.parking,
		sidewalk = opts.sidewalk or def.sidewalk,
		shoulder = opts.shoulder or def.shoulder,
		speed = opts.speed or SPEED[class],
		layer = opts.layer or 0,
		noCross = opts.noCross == true,
		keepDeadEnd = opts.keepDeadEnd == true,
		traffic = if opts.traffic ~= nil
			then opts.traffic
			else (class ~= "pier" and class ~= "channel" and class ~= "runway" and class ~= "service" and class ~= "alley"),
		corridor = opts.corridor,
		generated = opts.generated == true,
		district = opts.district,
		yMode = opts.yMode or "ground",
		y0 = opts.y0,
		y1 = opts.y1,
		fixedY = opts.fixedY,
		profile = opts.profile,
		minProfile = opts.minProfile,
		maxGrade = opts.maxGrade or def.grade,
		bridges = opts.bridges,
	}
	table.insert(ways, w)
	return w
end

-- Curb-to-curb width of a way.
local function wayWidth(w: Way): number
	local lanesTotal = if w.oneWay then w.lanes else w.lanes * 2
	local park = if w.parking then 2 * S.PARKING_LANE else 0
	if w.class == "freeway" then
		return w.lanes * LANE + S.FREEWAY_SHOULDER_OUT + S.FREEWAY_SHOULDER_IN
	end
	return lanesTotal * LANE + w.median + park + 2 * w.shoulder
end

local function P(x: number, z: number): P2
	return { x = x, z = z }
end

local function reversed(pts: { P2 }): { P2 }
	local out: { P2 } = {}
	for i = #pts, 1, -1 do
		table.insert(out, pts[i])
	end
	return out
end

-- Freeway corridor: two one-way carriageways offset from a centerline. Returns (forward, backward) ways; forward
-- runs with the centerline direction on its right-hand side.
type Corridor = { name: string, center: { P2 }, fwd: Way, bwd: Way, offset: number }

local function corridor(
	name: string,
	center: { P2 },
	lanes: number,
	labels: { string },
	o: WayOpts?
): Corridor
	local cw = lanes * LANE + S.FREEWAY_SHOULDER_OUT + S.FREEWAY_SHOULDER_IN
	local off = cw / 2 + S.CARRIAGEWAY_GAP / 2
	local function make(pts: { P2 }, label: string): Way
		local opts: WayOpts = {}
		for k, v in (o or {}) :: any do
			(opts :: any)[k] = v
		end
		opts.lanes = lanes
		opts.oneWay = true
		opts.layer = opts.layer or 1
		opts.corridor = name
		opts.yMode = opts.yMode or "deck"
		return addWay(name .. " " .. label, "freeway", pts, opts)
	end
	local fwd = make(WorldGen.polyOffset(center, off), labels[1])
	local bwd = make(reversed(WorldGen.polyOffset(center, -off)), labels[2])
	return { name = name, center = center, fwd = fwd, bwd = bwd, offset = off }
end

-- Point + tangent on a carriageway nearest to (x, z): returns the arc length and the point.
local function portOn(w: Way, x: number, z: number): (number, P2, number, number)
	local _, s = WorldGen.polyProject(w.pts, x, z)
	local px, pz, tx, tz = WorldGen.polyAt(w.pts, s)
	return s, P(px, pz), tx, tz
end

local function portAt(w: Way, s: number): (P2, number, number)
	local px, pz, tx, tz = WorldGen.polyAt(w.pts, s)
	return P(px, pz), tx, tz
end

-- Eased ramp profile between absolute heights (0.5 linear + 0.5 smoothstep: max grade 1.25x average).
local function easedRamp(y0: number, y1: number): (number, number) -> number
	return function(s: number, L: number): number
		local t = if L > 0 then math.clamp(s / L, 0, 1) else 0
		local e = 0.5 * t + 0.5 * t * t * (3 - 2 * t)
		return y0 + (y1 - y0) * e
	end
end

-- Flyover profile: deck at both ends, `top` across the middle (rise over riseLen, fall over fallLen).
local function humpProfile(yEnd0: number, top: number, yEnd1: number, riseLen: number, fallLen: number): (number, number) -> number
	return function(s: number, L: number): number
		local r = math.min(riseLen, L * 0.45)
		local f = math.min(fallLen, L * 0.45)
		if s < r then
			return yEnd0 + (top - yEnd0) * SMOOTH(0, r, s)
		elseif s > L - f then
			return top + (yEnd1 - top) * SMOOTH(L - f, L, s)
		end
		return top
	end
end

-- Trumpet interchange where branch corridor `branchCenter` (starting ON main's centerline, leaving it at a right
-- angle) meets corridor `main`. All six movements; one bridge carries two ramps over the main line, one 270-degree
-- loop and one sweeping semi-directional ramp sit on the far side, two direct ramps on the branch side.
-- Returns the branch corridor (carriageways start where the ramps land).
local function trumpet(name: string, main: Corridor, branchCenter: { P2 }, lanes: number, labels: { string }): Corridor
	local J = branchCenter[1]
	local o = main.offset
	-- main direction at J
	local _, _, mtx, mtz = WorldGen.polyAt(main.center, select(2, WorldGen.polyProject(main.center, J.x, J.z)))
	-- branch outward direction
	local bx, bz = branchCenter[2].x - J.x, branchCenter[2].z - J.z
	local bl = math.sqrt(bx * bx + bz * bz)
	bx, bz = bx / bl, bz / bl
	local rx, rz = WorldGen.right(mtx, mtz)
	local sigma = if rx * bx + rz * bz > 0 then 1 else -1
	-- near carriageway N (on the branch side) travels along e; far F travels -e. Local frame: a along e, b along w.
	local N = if sigma > 0 then main.fwd else main.bwd
	local F = if sigma > 0 then main.bwd else main.fwd
	local ex, ez = mtx * sigma, mtz * sigma
	local wx, wz = WorldGen.right(ex, ez) -- == branch side
	local function L(a: number, b: number): P2
		return P(J.x + ex * a + wx * b, J.z + ez * a + wz * b)
	end
	local R = 150
	local ob = o -- branch carriageway offset (same cross-section)
	local Lb = 300 -- branch carriageways start this far beyond the near carriageway
	local Lm = 260
	local Ln = 380
	local Ls = 220
	local gapM = 16
	local top = DECK_Y + S.FLYOVER

	-- branch corridor beyond the junction
	local bStart = o + Lb
	local branchL = WorldGen.polyLength(branchCenter)
	local slice = WorldGen.polySlice(branchCenter, bStart, branchL)
	local branch = corridor(name, slice, lanes, labels, { yMode = "deck" })
	local Out, In = branch.fwd, branch.bwd -- fwd = outward (right side = -e side, the "Out" side)

	-- 1. N -> Out (direct, right exit before the junction)
	do
		local s, p, tx, tz = portOn(N, L(-ob - Ln, o).x, L(-ob - Ln, o).z)
		local _ = s
		local endS = Lm
		local q, qx, qz = portAt(Out, endS)
		local k = 0.42 * WorldGen.dist(p.x, p.z, q.x, q.z)
		local pts =
			WorldGen.bezier(p, P(p.x + tx * k, p.z + tz * k), P(q.x - qx * k, q.z - qz * k), q, 24)
		addWay(name .. " ramp", "ramp", pts, { oneWay = true, layer = 1, noCross = true, yMode = "fixed", fixedY = DECK_Y })
	end
	-- 2. In -> N (direct, right merge after the junction)
	do
		local inL = WorldGen.polyLength(In.pts)
		local p, px, pz = portAt(In, inL - Lm)
		local _, q, qx, qz = portOn(N, L(ob + Ln, o).x, L(ob + Ln, o).z)
		local k = 0.42 * WorldGen.dist(p.x, p.z, q.x, q.z)
		local pts =
			WorldGen.bezier(p, P(p.x + px * k, p.z + pz * k), P(q.x - qx * k, q.z - qz * k), q, 24)
		addWay(name .. " ramp", "ramp", pts, { oneWay = true, layer = 1, noCross = true, yMode = "fixed", fixedY = DECK_Y })
	end
	-- 3. In -> F: over the bridge, then a 270-degree loop on the far side merging into F
	do
		local inL = WorldGen.polyLength(In.pts)
		local start, _, _ = portAt(In, inL)
		local b0 = -o - R - gapM
		local ctrl: { P2 } = { start, L(ob, -o + 0) }
		local pts: { P2 } = { start }
		for _, q in WorldGen.densify({ start, L(ob, b0) }, 30) do
			if q ~= pts[1] then
				table.insert(pts, q)
			end
		end
		local _ = ctrl
		-- loop: center (ob + R, b0); phi from pi to 5pi/2
		local n = 40
		for i = 1, n do
			local phi = math.pi + (1.5 * math.pi) * i / n
			local a = ob + R + R * math.cos(phi)
			local b = b0 + R * math.sin(phi)
			table.insert(pts, L(a, b))
		end
		-- merge into F heading -e
		local _, q, qx, qz = portOn(F, L(ob + 0.35 * R, -o).x, L(ob + 0.35 * R, -o).z)
		local last = pts[#pts]
		local k = 0.4 * WorldGen.dist(last.x, last.z, q.x, q.z)
		local merge = WorldGen.bezier(last, P(last.x - ex * k, last.z - ez * k), P(q.x - qx * k, q.z - qz * k), q, 20)
		for i = 2, #merge do
			table.insert(pts, merge[i])
		end
		local Ltot = WorldGen.polyLength(pts)
		local crossS = WorldGen.dist(start.x, start.z, L(ob, -o - 30).x, L(ob, -o - 30).z)
		addWay(name .. " loop", "ramp", pts, {
			oneWay = true,
			layer = 2,
			noCross = true,
			yMode = "profile",
			profile = humpProfile(DECK_Y, top, DECK_Y, math.max(120, crossS - Lb * 0.1), Ltot * 0.6),
		})
	end
	-- 4. F -> Out: sweeping semi-directional ramp around the loop, over the bridge
	do
		local aD = ob + 2 * R + Ls
		local _, p, tx, tz = portOn(F, L(aD, -o).x, L(aD, -o).z)
		local bTop = -o - 2 * R - gapM - 80
		local ctrl: { P2 } = {
			p,
			P(p.x + tx * 140 - wx * 40, p.z + tz * 140 - wz * 40),
			L(ob + 2 * R + 60, bTop),
			L(-ob, bTop),
			L(-ob, o + Lb),
		}
		local pts = WorldGen.fillet(ctrl, 170, nil, 24)
		local Ltot = WorldGen.polyLength(pts)
		local tail = WorldGen.dist(L(-ob, -o - 30).x, L(-ob, -o - 30).z, L(-ob, o + Lb).x, L(-ob, o + Lb).z)
		addWay(name .. " flyover", "ramp", pts, {
			oneWay = true,
			layer = 2,
			noCross = true,
			lanes = 1,
			yMode = "profile",
			profile = humpProfile(DECK_Y, top, DECK_Y, (Ltot - tail) * 0.55, tail * 0.75),
		})
	end
	return branch
end

-- Diamond interchange where a surface road (way `ave`) crosses corridor `main` near (cx, cz).
local function diamond(main: Corridor, ave: Way, cx: number, cz: number, Ld: number?)
	local ld = Ld or 420
	local _, sC = WorldGen.polyProject(main.center, cx, cz)
	local px, pz, tx, tz = WorldGen.polyAt(main.center, sC)
	local lateral = main.offset + 26 + 22 -- ramp centerline from the corridor centerline
	for _, cw in { main.fwd, main.bwd } do
		local dir = if cw == main.fwd then 1 else -1
		local ux, uz = tx * dir, tz * dir -- carriageway travel
		local rx, rz = WorldGen.right(ux, uz)
		-- off-ramp (upstream), on-ramp (downstream)
		for _, kind in { "off", "on" } do
			local sign = if kind == "off" then -1 else 1
			local portPt = P(px + ux * ld * sign + rx * main.offset, pz + uz * ld * sign + rz * main.offset)
			local _, port, ptx, ptz = portOn(cw, portPt.x, portPt.z)
			-- parallel line at `lateral`, find where it meets the avenue
			local l0 = P(px + ux * (ld * 0.62) * sign + rx * lateral, pz + uz * (ld * 0.62) * sign + rz * lateral)
			local l1 = P(px - ux * 260 * sign + rx * lateral, pz - uz * 260 * sign + rz * lateral)
			local hitX: number?, hitZ: number? = nil, nil
			for i = 1, #ave.pts - 1 do
				local a, b = ave.pts[i], ave.pts[i + 1]
				local t = WorldGen.segIntersect(l0.x, l0.z, l1.x, l1.z, a.x, a.z, b.x, b.z, 0)
				if t then
					hitX, hitZ = l0.x + (l1.x - l0.x) * t, l0.z + (l1.z - l0.z) * t
					break
				end
			end
			assert(hitX and hitZ, "diamond: avenue " .. ave.name .. " does not cross the ramp line")
			local term = P(hitX, hitZ)
			local pts: { P2 }
			if kind == "off" then
				local k = 0.42 * WorldGen.dist(port.x, port.z, l0.x, l0.z)
				pts = WorldGen.bezier(port, P(port.x + ptx * k, port.z + ptz * k), P(l0.x - ux * k, l0.z - uz * k), l0, 24)
				table.insert(pts, term)
				addWay(main.name .. " off-ramp", "ramp", pts, {
					oneWay = true,
					layer = 1,
					noCross = true,
					yMode = "profile",
					profile = easedRamp(DECK_Y, GRADE),
				})
			else
				local k = 0.42 * WorldGen.dist(l0.x, l0.z, port.x, port.z)
				pts = { term }
				for _, q in WorldGen.bezier(l0, P(l0.x + ux * k, l0.z + uz * k), P(port.x - ptx * k, port.z - ptz * k), port, 24) do
					table.insert(pts, q)
				end
				addWay(main.name .. " on-ramp", "ramp", pts, {
					oneWay = true,
					layer = 1,
					noCross = true,
					yMode = "profile",
					profile = easedRamp(GRADE, DECK_Y),
				})
			end
		end
	end
end

-- Merge two carriageways of a corridor into one two-way road at the corridor's far end (last `len` studs).
local function corridorTail(c: Corridor, len: number, name: string, class: RoadClass, o: WayOpts?): Way
	-- trim carriageways: fwd ends at the centerline point (L - len), bwd starts there
	local L = WorldGen.polyLength(c.center)
	local mx, mz = WorldGen.polyAt(c.center, L - len)
	local m = P(mx, mz)
	local function trimEnd(w: Way)
		local _, s = WorldGen.polyProject(w.pts, mx, mz)
		local pts = WorldGen.polySlice(w.pts, 0, math.max(0, s - 160))
		local _, _, tx, tz = WorldGen.polyAt(w.pts, s - 160)
		local a = pts[#pts]
		local k = 70
		local tail = WorldGen.bezier(a, P(a.x + tx * k, a.z + tz * k), P(m.x - tx * k * 0.5, m.z - tz * k * 0.5), m, 20)
		for i = 2, #tail do
			table.insert(pts, tail[i])
		end
		w.pts = pts
	end
	local function trimStart(w: Way)
		local wl = WorldGen.polyLength(w.pts)
		local _, s = WorldGen.polyProject(w.pts, mx, mz)
		local pts = WorldGen.polySlice(w.pts, math.min(wl, s + 160), wl)
		local _, _, tx, tz = WorldGen.polyAt(w.pts, s + 160)
		local a = pts[1]
		local k = 70
		local head = WorldGen.bezier(m, P(m.x + tx * k * 0.5, m.z + tz * k * 0.5), P(a.x - tx * k, a.z - tz * k), a, 20)
		for i = 2, #pts do
			table.insert(head, pts[i])
		end
		w.pts = head
	end
	trimEnd(c.fwd)
	trimStart(c.bwd)
	local tail = WorldGen.polySlice(c.center, L - len, L)
	return addWay(name, class, tail, o)
end

