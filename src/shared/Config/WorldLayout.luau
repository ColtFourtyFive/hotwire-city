			return ch.floorNorthY + (ch.floorSouthY - ch.floorNorthY) * (sc / L)
		end,
	})
	local function floorY(z: number): number
		local _, s = WorldGen.polyProject(ch.points, 1955, z)
		return ch.floorNorthY + (ch.floorSouthY - ch.floorNorthY) * (s / L)
