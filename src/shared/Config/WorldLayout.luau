local function v3list(list: { { number } }): { Vector3 }
	local out: { Vector3 } = {}
	for _, p in WorldGen.fillet(poly(list), 600, nil, 40) do
		table.insert(out, Vector3.new(p.x, gradeAt(p.x, p.z), p.z))
	end
	return out
end

