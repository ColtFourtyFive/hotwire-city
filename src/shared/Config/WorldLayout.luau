export type LotRule = {
	width: { number }, -- frontage {min, max}
	depth: { number },
	setback: { number },
	density: number, -- share of frontage that gets a lot
	uses: { { any } }, -- { use, weight }
}

export type District = {
	id: string,
	name: string,
	style: string, -- facade / dressing style key for MapBuilder v2
	materials: { string }, -- PBR MaterialVariant keys, most used first
	polygon: { Vector3 },
	priority: number,
	height: { number }, -- building height range (studs)
	peak: { number }?, -- { x, z, radius }: heights fall off from here (downtown skyline)
	density: number,
	heat: number, -- police presence 1..5
	carTier: string, -- street spawn quality (soft progression)
	color: { number }, -- plan tint
	lot: LotRule,
	sidewalk: number,
}

local function poly(list: { { number } }): { P2 }
	local out: { P2 } = {}
	for _, p in list do
		table.insert(out, { x = p[1], z = p[2] })
	end
	return out
end

type DistrictDef = {
	id: string,
	name: string,
	style: string,
	materials: { string },
	poly: { P2 },
	priority: number,
	height: { number },
	peak: { number }?,
	density: number,
	heat: number,
	carTier: string,
	color: { number },
	lot: LotRule,
	sidewalk: number,
}

