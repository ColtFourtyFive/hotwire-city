		drop = 0.05,
		namesU = { "Rail Street", "Boxcar Ave", "Coupler St", "Ballast St" },
		namesV = { "Smelter Rd", "Slag St", "Cinder St", "Rivet St", "Gantry St", "Pylon St" },
		seed = 606,
	},
	{
		district = "rust",
		origin = P(2900, 1700),
		angle = 0,
		us = range(-800, 700, 500, 40, 606),
		vs = range(-1100, 1100, 430, 40, 607),
		clip = poly({ { 2110, 1520 }, { 3700, 1520 }, { 3700, 3000 }, { 2110, 3000 } }),
		parking = false,
		drop = 0.05,
		namesU = { "Rail Street", "Boxcar Ave", "Coupler St", "Ballast St" },
		namesV = { "Smelter Rd", "Slag St", "Cinder St", "Rivet St", "Gantry St", "Pylon St" },
		seed = 607,
	},
	{
		district = "cactus",
		origin = P(4330, -560),
		angle = 0,
		us = { -330, -110, 110, 330 },
		vs = { -330, -110, 220 },
		clip = poly({ { 3930, -930 }, { 4730, -930 }, { 4730, -170 }, { 3930, -170 } }),
		parking = true,
		sidewalk = 10,
		drop = 0.0,
		namesU = { "Saguaro St", "Ocotillo St", "Yucca St", "Mesquite St" },
		namesV = { "Rattler Rd", "Main Street", "Coyote St" },
		seed = 707,
	},
}

local authoredCount = #ways

-- Freeway / ramp footprints that generated streets must not run into (low ramp ends, parallel decks).
type Block = { pts: { P2 }, ys: ((s: number) -> number)?, half: number, low: boolean }

local function generateGrid(g: GridSpec)
	local a = math.rad(g.angle)
	local ux, uz = math.cos(a), math.sin(a)
	local vx, vz = -uz, ux
	local function W(u: number, v: number): P2
		return P(g.origin.x + ux * u + vx * v, g.origin.z + uz * u + vz * v)
	end
	local minU, maxU = g.us[1], g.us[#g.us]
	local minV, maxV = g.vs[1], g.vs[#g.vs]
	local padU, padV = 400, 400
	local function emit(fam: string, idx: number, pts: { P2 })
		-- clip to the district clip polygon (by segments), keep pieces
		local pieces: { { P2 } } = {}
		local cur: { P2 } = {}
		for i = 1, #pts - 1 do
			local p, q = pts[i], pts[i + 1]
			local ins = WorldGen.clipSegToPoly(p.x, p.z, q.x, q.z, g.clip)
			if #ins == 0 then
				if #cur >= 2 then
					table.insert(pieces, cur)
				end
				cur = {}
			else
				for k, iv in ins do
					local t0, t1 = iv[1], iv[2]
					local a0 = P(p.x + (q.x - p.x) * t0, p.z + (q.z - p.z) * t0)
					local a1 = P(p.x + (q.x - p.x) * t1, p.z + (q.z - p.z) * t1)
					if t0 > 1e-9 or k > 1 then
						if #cur >= 2 then
							table.insert(pieces, cur)
						end
						cur = { a0 }
					elseif #cur == 0 then
						cur = { a0 }
					end
					table.insert(cur, a1)
					if t1 < 1 - 1e-9 then
						table.insert(pieces, cur)
						cur = {}
					end
				end
			end
		end
		if #cur >= 2 then
			table.insert(pieces, cur)
		end
		local names = if fam == "u" then g.namesU else g.namesV
		local name = if names and names[idx] then names[idx] else (g.district .. " " .. fam .. idx)
		local oneDir = if fam == "u" then (g.oneWayU and g.oneWayU[idx]) else (g.oneWayV and g.oneWayV[idx])
		for _, piece in pieces do
			if WorldGen.polyLength(piece) < 40 then
				continue
			end
			local pts2 = piece
			if oneDir and oneDir < 0 then
				pts2 = reversed(piece)
			end
			addWay(name, g.class or "street", pts2, {
				lanes = if oneDir then (g.lanes or 2) else 1,
				oneWay = oneDir ~= nil,
				parking = g.parking,
				sidewalk = g.sidewalk,
				generated = true,
				district = g.district,
			})
		end
	end
	-- streets along v at each u (split per block so some interior sides can be dropped)
	for i, u in g.us do
		local pts: { P2 } = {}
		local v = minV - padV
		local stepV = 40
		while v <= maxV + padV + 1e-6 do
			local uu = u
			if g.warp then
				uu += g.warp[1] * math.sin((v / g.warp[2]) * 2 * math.pi + i * 0.7)
			end
			table.insert(pts, W(uu, v))
			v += stepV
		end
		-- drop random interior block sides
		if g.drop and g.drop > 0 and i > 1 and i < #g.us then
			local kept: { P2 } = {}
			local pieces: { { P2 } } = {}
			for k = 1, #g.vs - 1 do
				local dropIt = WorldGen.hash(i, k, g.seed) < g.drop
				if dropIt then
					-- split: everything between vs[k] and vs[k+1] is removed
					local cut0, cut1 = g.vs[k] + 2, g.vs[k + 1] - 2
					local before: { P2 } = {}
					local after: { P2 } = {}
					for _, p in (if #kept > 0 then kept else pts) do
						local pv = (p.x - g.origin.x) * vx + (p.z - g.origin.z) * vz
						if pv <= cut0 then
							table.insert(before, p)
						elseif pv >= cut1 then
							table.insert(after, p)
						end
					end
					if #before >= 2 then
						table.insert(pieces, before)
					end
					kept = after
				end
			end
			if #pieces > 0 then
				table.insert(pieces, kept)
				for _, pc in pieces do
					if #pc >= 2 then
						emit("u", i, pc)
					end
				end
				continue
			end
		end
		emit("u", i, pts)
	end
	for i, v in g.vs do
		local pts: { P2 } = {}
		local u = minU - padU
		while u <= maxU + padU + 1e-6 do
			local vv = v
			if g.warp then
				vv += g.warp[1] * 0.6 * math.sin((u / (g.warp[2] * 1.3)) * 2 * math.pi + i)
			end
			table.insert(pts, W(u, vv))
			u += 40
		end
		if g.drop and g.drop > 0 and i > 1 and i < #g.vs then
			local pieces: { { P2 } } = {}
			local cur: { P2 } = {}
			local cutRanges = {}
			for k = 1, #g.us - 1 do
				if WorldGen.hash(k, i, g.seed + 1) < g.drop then
					table.insert(cutRanges, { g.us[k] + 2, g.us[k + 1] - 2 })
				end
			end
			if #cutRanges > 0 then
				for _, p in pts do
					local pu = (p.x - g.origin.x) * ux + (p.z - g.origin.z) * uz
					local inCut = false
					for _, r in cutRanges do
						if pu > r[1] and pu < r[2] then
							inCut = true
						end
					end
					if inCut then
						if #cur >= 2 then
							table.insert(pieces, cur)
						end
						cur = {}
					else
						table.insert(cur, p)
					end
				end
				if #cur >= 2 then
					table.insert(pieces, cur)
				end
				for _, pc in pieces do
					emit("v", i, pc)
				end
				continue
			end
		end
		emit("v", i, pts)
	end
end

for _, g in GRIDS do
	generateGrid(g)
end

-------------------------------------------------------------------------------------------------------------------------
-- 4e. Clean generated streets: cut them where they would run into low ramps, freeway piers or reserved areas,
--     drop pieces that duplicate a nearby parallel arterial, extend loose ends onto the road they nearly reach.
-------------------------------------------------------------------------------------------------------------------------

-- Reserved areas no generated street may enter (airport airside, port yards, parks, the channel).
local RESERVED_AREAS: { { poly: { P2 }, name: string } } = {
	{ name = "Rust River", poly = {} }, -- filled below from the channel corridor
	{ name = "Rail Yard", poly = poly({ { 2110, 1180 }, { 3700, 1180 }, { 3700, 1520 }, { 2110, 1520 } }) },
	{ name = "Hotwire Plaza", poly = poly({ { 175, -240 }, { 470, -240 }, { 470, 55 }, { 175, 55 } }) },
	{ name = "Echo Park", poly = poly({ { -2050, 1600 }, { -1450, 1600 }, { -1450, 2000 }, { -2050, 2000 } }) },
}
do
	local ch = WorldLayout.Channel
	local left = WorldGen.polyOffset(ch.points, -(ch.floorHalfWidth + ch.wallRun + 6))
	local right = WorldGen.polyOffset(ch.points, ch.floorHalfWidth + ch.wallRun + 6)
	local ring: { P2 } = {}
	for _, p in left do
		table.insert(ring, p)
	end
	for i = #right, 1, -1 do
		table.insert(ring, right[i])
	end
	RESERVED_AREAS[1].poly = ring
end

local function lowRampAt(w: Way, s: number, L: number): number
	if w.profile then
		return w.profile(s, L)
	end
	if w.yMode == "fixed" and w.fixedY then
		return w.fixedY
	end
	return DECK_Y
end

local function cleanGenerated()
	-- corridor & ramp blockers
	local blockers: { { pts: { P2 }, half: number, w: Way, L: number } } = {}
	for i = 1, authoredCount do
		local w = ways[i]
		if w.class == "freeway" or w.class == "ramp" then
			table.insert(blockers, { pts = w.pts, half = wayWidth(w) / 2 + 10, w = w, L = WorldGen.polyLength(w.pts) })
		end
	end
	local arterials: { Way } = {}
	for i = 1, authoredCount do
		local w = ways[i]
		if w.layer == 0 and (w.class == "boulevard" or w.class == "avenue" or w.class == "street" or w.class == "highway" or w.class == "rural") then
			table.insert(arterials, w)
		end
	end
	local kept: { Way } = {}
	for i = 1, authoredCount do
		table.insert(kept, ways[i])
	end
	for i = authoredCount + 1, #ways do
		local w = ways[i]
		local pts = WorldGen.densify(w.pts, 10)
		local blocked = table.create(#pts, false)
		for k, p in pts do
			-- reserved areas
			for _, r in RESERVED_AREAS do
				if WorldGen.pointInPoly(r.poly, p.x, p.z) then
					blocked[k] = true
				end
			end
			-- low ramps / parallel decks
			if not blocked[k] then
				for _, b in blockers do
					local d, s = WorldGen.polyProject(b.pts, p.x, p.z)
					if d < b.half then
						local y = lowRampAt(b.w, s, b.L)
						if y < GRADE + S.CLEARANCE + 4 then
							blocked[k] = true
							break
						end
						-- running along under a deck (parallel within 30 degrees) -> blocked
						local nxt = pts[math.min(k + 1, #pts)]
						local prv = pts[math.max(k - 1, 1)]
						local dx, dz = nxt.x - prv.x, nxt.z - prv.z
						local dl = math.sqrt(dx * dx + dz * dz)
						if dl > 1e-6 then
							local _, _, tx, tz = WorldGen.polyAt(b.pts, s)
							if math.abs((dx * tx + dz * tz) / dl) > 0.86 then
								blocked[k] = true
								break
							end
						end
					end
				end
			end
			-- duplicates a parallel arterial within 70 studs
			if not blocked[k] then
				for _, a in arterials do
					local d, s = WorldGen.polyProject(a.pts, p.x, p.z)
					if d < 70 then
						local nxt = pts[math.min(k + 1, #pts)]
						local prv = pts[math.max(k - 1, 1)]
						local dx, dz = nxt.x - prv.x, nxt.z - prv.z
						local dl = math.sqrt(dx * dx + dz * dz)
						local _, _, tx, tz = WorldGen.polyAt(a.pts, s)
						if dl > 1e-6 and math.abs((dx * tx + dz * tz) / dl) > 0.8 then
							blocked[k] = true
							break
						end
					end
				end
			end
			-- off land
			if not blocked[k] then
				local sd = shore(p.x, p.z)
				if sd < 60 then
					blocked[k] = true
				end
			end
		end
		local cur: { P2 } = {}
		local function flush()
			if #cur >= 2 and WorldGen.polyLength(cur) >= 60 then
				local copy: Way = table.clone(w)
				copy.pts = cur
				table.insert(kept, copy)
			end
			cur = {}
		end
		for k, p in pts do
			if blocked[k] then
				flush()
			else
				table.insert(cur, p)
			end
		end
		flush()
	end
	-- simplify densified pieces back to their corners
	for i = authoredCount + 1, #kept do
		local w = kept[i]
		local out: { P2 } = { w.pts[1] }
		for k = 2, #w.pts - 1 do
			local a, b, c = out[#out], w.pts[k], w.pts[k + 1]
			local abx, abz = b.x - a.x, b.z - a.z
			local bcx, bcz = c.x - b.x, c.z - b.z
			local cr = math.abs(abx * bcz - abz * bcx)
			local la = math.sqrt(abx * abx + abz * abz)
			local lb = math.sqrt(bcx * bcx + bcz * bcz)
			if cr > 0.004 * la * lb then
				table.insert(out, b)
			end
		end
		table.insert(out, w.pts[#w.pts])
		w.pts = out
	end
	-- extend loose ends up to 70 studs onto a ground road they point at
	local ground: { Way } = {}
	for _, w in kept do
		if w.layer == 0 and not w.noCross then
			table.insert(ground, w)
		end
	end
	for i = authoredCount + 1, #kept do
		local w = kept[i]
		for _, endIdx in { 1, #w.pts } do
			local p = w.pts[endIdx]
			local q = w.pts[if endIdx == 1 then 2 else #w.pts - 1]
			local dx, dz = p.x - q.x, p.z - q.z
			local dl = math.sqrt(dx * dx + dz * dz)
			if dl < 1e-6 then
				continue
			end
			dx, dz = dx / dl, dz / dl
			local fx, fz = p.x + dx * 70, p.z + dz * 70
			local bestT: number? = nil
			for _, o in ground do
				if o ~= w then
					for k = 1, #o.pts - 1 do
						local a, b = o.pts[k], o.pts[k + 1]
						local t = WorldGen.segIntersect(p.x, p.z, fx, fz, a.x, a.z, b.x, b.z, 0)
						if t and t > 1e-4 and (bestT == nil or t < bestT) then
							bestT = t
						end
					end
				end
			end
			if bestT then
				w.pts[endIdx] = P(p.x + (fx - p.x) * bestT, p.z + (fz - p.z) * bestT)
			end
		end
	end
	ways = kept
	for i, w in ways do
		w.id = i
	end
end
cleanGenerated()

-------------------------------------------------------------------------------------------------------------------------
-- 5. Vertical alignment: heights per vertex (ground ways follow the terrain grade-limited and pinned to the roads
--    they join; elevated ways use their profiles)
-------------------------------------------------------------------------------------------------------------------------

local CLASS_ORDER: { [string]: number } = {
	freeway = 1,
	ramp = 2,
	highway = 3,
	boulevard = 4,
	avenue = 5,
	rural = 6,
	runway = 7,
	pier = 7,
	channel = 7,
	street = 8,
	service = 9,
	dirt = 9,
	alley = 10,
}

local order: { Way } = table.clone(ways)
table.sort(order, function(a: Way, b: Way): boolean
	local oa, ob = CLASS_ORDER[a.class] or 9, CLASS_ORDER[b.class] or 9
	if oa ~= ob then
		return oa < ob
	end
	if a.generated ~= b.generated then
		return not a.generated
	end
	return a.id < b.id
end)

local done: { Way } = {}

-- Height of an already-aligned way at the point nearest (x, z), if it passes within tol.
local function pinFrom(x: number, z: number, tol: number, layerOnly: number?): number?
	for _, w in done do
		if layerOnly == nil or (w.layer == layerOnly and not w.noCross) then
			local d, s, _, _, i = WorldGen.polyProject(w.pts, x, z)
			if d <= tol then
				local ys = w.ys :: { number }
				-- arc length to vertex i
				local acc = 0
				for k = 2, i do
					acc += WorldGen.dist(w.pts[k - 1].x, w.pts[k - 1].z, w.pts[k].x, w.pts[k].z)
				end
				local seg = WorldGen.dist(w.pts[i].x, w.pts[i].z, w.pts[i + 1].x, w.pts[i + 1].z)
				local t = if seg > 1e-9 then (s - acc) / seg else 0
				return ys[i] + (ys[i + 1] - ys[i]) * math.clamp(t, 0, 1)
			end
		end
	end
	return nil
end

local function alignWay(w: Way)
	local isFlatCity = function(x: number, z: number): boolean
		return math.abs(gradeAt(x, z) - GRADE) < 0.05
	end
	if w.yMode == "ground" then
		-- densify on hills, insert crossing points with aligned ground ways so we can pin them
		local pts = w.pts
		local dense: { P2 } = { pts[1] }
		for i = 2, #pts do
			local a, b = pts[i - 1], pts[i]
			local len = WorldGen.dist(a.x, a.z, b.x, b.z)
			local flat = isFlatCity(a.x, a.z) and isFlatCity(b.x, b.z) and isFlatCity((a.x + b.x) / 2, (a.z + b.z) / 2)
			local n = if flat then 1 else math.max(1, math.ceil(len / 36))
			for k = 1, n do
				local t = k / n
				table.insert(dense, P(a.x + (b.x - a.x) * t, a.z + (b.z - a.z) * t))
			end
		end
		-- crossing pins (same layer ground ways, both crossable)
		local pinned: { [number]: number } = {}
		local withPins: { P2 } = { dense[1] }
		local pinAt: { number? } = { nil }
		for i = 2, #dense do
			local a, b = dense[i - 1], dense[i]
			local hits: { { number } } = {}
			if not w.noCross then
				for _, o in done do
					if o.layer == w.layer and not o.noCross and o.yMode == "ground" then
						for k = 1, #o.pts - 1 do
							local c, d = o.pts[k], o.pts[k + 1]
							local t, u = WorldGen.segIntersect(a.x, a.z, b.x, b.z, c.x, c.z, d.x, d.z, 0.5)
							if t and u and t > 1e-6 and t < 1 - 1e-6 then
								local ys = o.ys :: { number }
								table.insert(hits, { t, ys[k] + (ys[k + 1] - ys[k]) * u })
							end
						end
					end
				end
			end
			table.sort(hits, function(p: { number }, q: { number }): boolean
				return p[1] < q[1]
			end)
			for _, h in hits do
				table.insert(withPins, P(a.x + (b.x - a.x) * h[1], a.z + (b.z - a.z) * h[1]))
				pinAt[#withPins] = h[2]
			end
			table.insert(withPins, b)
		end
		local n = #withPins
		-- endpoint pins (any processed way passing through the end, e.g. T-junction onto an aligned road)
		for _, k in { 1, n } do
			if pinAt[k] == nil then
				pinAt[k] = pinFrom(withPins[k].x, withPins[k].z, 1.6, nil)
			end
		end
		local ys = table.create(n, 0)
		local target = table.create(n, 0)
		for k, p in withPins do
			target[k] = gradeAt(p.x, p.z)
			if w.minProfile then
				-- arc length
				local acc = 0
				for j = 2, k do
					acc += WorldGen.dist(withPins[j - 1].x, withPins[j - 1].z, withPins[j].x, withPins[j].z)
				end
				target[k] = math.max(target[k], w.minProfile(acc, 0))
			end
			if pinAt[k] then
				pinned[k] = pinAt[k] :: number
			end
		end
		-- grade-limited fit between pins: clamp the terrain into the cones of the neighbouring pins
		local g = w.maxGrade
		local lo = table.create(n, -math.huge)
		local hi = table.create(n, math.huge)
		-- forward cone
		local lastY: number? = nil
		local acc = 0
		for k = 1, n do
			if k > 1 then
				acc = WorldGen.dist(withPins[k - 1].x, withPins[k - 1].z, withPins[k].x, withPins[k].z)
			end
			if lastY ~= nil then
				lo[k] = math.max(lo[k], (lastY :: number) - g * acc)
				hi[k] = math.min(hi[k], (lastY :: number) + g * acc)
			end
			local y = math.clamp(target[k], lo[k], hi[k])
			if pinned[k] then
				y = pinned[k]
			end
			ys[k] = y
			lastY = y
		end
		-- backward pass
		local nextY: number? = nil
		for k = n, 1, -1 do
			local seg = if k < n then WorldGen.dist(withPins[k].x, withPins[k].z, withPins[k + 1].x, withPins[k + 1].z) else 0
			local y = ys[k]
			if nextY ~= nil then
				y = math.clamp(y, (nextY :: number) - g * seg, (nextY :: number) + g * seg)
			end
			if pinned[k] then
				y = pinned[k]
			end
			ys[k] = y
			nextY = y
		end
		w.pts = withPins
		w.ys = ys
	else
		local pts = WorldGen.densify(w.pts, 40)
		local L = WorldGen.polyLength(pts)
		local ys = table.create(#pts, 0)
		local acc = 0
		for k, p in pts do
			if k > 1 then
				acc += WorldGen.dist(pts[k - 1].x, pts[k - 1].z, p.x, p.z)
			end
			local y
			if w.yMode == "fixed" then
				y = w.fixedY or GRADE
			elseif w.yMode == "deck" then
				y = DECK_Y
			elseif w.yMode == "ramp" then
				y = easedRamp(w.y0 or GRADE, w.y1 or GRADE)(acc, L)
			else
				y = (w.profile :: (number, number) -> number)(acc, L)
			end
			ys[k] = y
		end
		w.pts = pts
		w.ys = ys
	end
	-- bridges: straight between span ends
	if w.bridges then
		for _, span in w.bridges do
			local acc = 0
			local ys = w.ys :: { number }
			local s0, s1 = span[1], span[2]
			local y0 = WorldGen.polyYAt(
				(function()
					local t: { P3 } = {}
					for k, p in w.pts do
						table.insert(t, { x = p.x, y = ys[k], z = p.z })
					end
					return t
				end)(),
				s0
			)
			local y1 = WorldGen.polyYAt(
				(function()
					local t: { P3 } = {}
					for k, p in w.pts do
						table.insert(t, { x = p.x, y = ys[k], z = p.z })
					end
					return t
				end)(),
				s1
			)
			for k = 1, #w.pts do
				if k > 1 then
					acc += WorldGen.dist(w.pts[k - 1].x, w.pts[k - 1].z, w.pts[k].x, w.pts[k].z)
				end
				if acc > s0 and acc < s1 then
					ys[k] = y0 + (y1 - y0) * (acc - s0) / (s1 - s0)
				end
			end
		end
	end
	table.insert(done, w)
end

for _, w in order do
	alignWay(w)
end

-- Skyline Drive flies over Sunwood Canyon (the H9) on the Canyon Bridge: span where the terrain dips into the canyon.
do
	local ys = skyline.ys :: { number }
	local _, sCross = WorldGen.polyProject(skyline.pts, -2880, -3190)
	local _ = sCross
	local acc = 0
	local accs = {}
	for k = 1, #skyline.pts do
		if k > 1 then
			acc += WorldGen.dist(skyline.pts[k - 1].x, skyline.pts[k - 1].z, skyline.pts[k].x, skyline.pts[k].z)
		end
		accs[k] = acc
	end
	-- find the span around the canyon crossing where the deck is level between rims
	local _, sC = WorldGen.polyProject(skyline.pts, H9center[#H9center - 1].x, H9center[#H9center - 1].z)
	local s0, s1 = sC - 380, sC + 380
	local y0 = WorldGen.polyYAt(
		(function()
			local t: { P3 } = {}
			for k, p in skyline.pts do
				table.insert(t, { x = p.x, y = ys[k], z = p.z })
			end
			return t
		end)(),
		s0
	)
	local y1 = WorldGen.polyYAt(
		(function()
			local t: { P3 } = {}
			for k, p in skyline.pts do
				table.insert(t, { x = p.x, y = ys[k], z = p.z })
			end
			return t
		end)(),
		s1
	)
	for k = 1, #skyline.pts do
		if accs[k] > s0 and accs[k] < s1 then
			ys[k] = math.max(ys[k], y0 + (y1 - y0) * (accs[k] - s0) / (s1 - s0))
		end
	end
	skyline.bridges = { { s0, s1 } }
end

-------------------------------------------------------------------------------------------------------------------------
-- 6. Compile the graph
-------------------------------------------------------------------------------------------------------------------------

local gways: { WorldGen.GWay } = {}
for _, w in ways do
	local pts3: { P3 } = {}
	local ys = w.ys :: { number }
	for k, p in w.pts do
		table.insert(pts3, { x = p.x, y = ys[k], z = p.z })
	end
	table.insert(gways, { pts = pts3, layer = w.layer, noCross = w.noCross })
end

local gnodes, gedges = WorldGen.planarize(gways, 1.6, 3)
gedges = WorldGen.pruneStubs(#gnodes, gedges, 130, function(e: WorldGen.GEdge): boolean
	return ways[e.way].keepDeadEnd or ways[e.way].class == "ramp" or ways[e.way].class == "freeway"
end)
gedges = WorldGen.mergeChains(#gnodes, gedges)
gnodes, gedges = WorldGen.compact(gnodes, gedges)

-------------------------------------------------------------------------------------------------------------------------
-- 7. Exported road graph
-------------------------------------------------------------------------------------------------------------------------

export type Node = {
	id: number,
	pos: Vector3,
	edges: { number },
	intersection: number?,
}

export type Edge = {
	id: number,
	a: number, -- node ids; one-way edges are travelled a -> b
	b: number,
	points: { Vector3 }, -- centerline polyline, Y = road surface
	length: number,
	class: RoadClass,
	name: string,
	oneWay: boolean,
	lanesF: number, -- lanes travelling a -> b
	lanesB: number, -- lanes travelling b -> a (0 when one-way)
	laneWidth: number,
	median: number,
	parking: boolean,
	width: number, -- curb-to-curb (median, parking lanes and shoulders included)
	sidewalk: number, -- each side
	shoulder: number,
	speed: number,
	layer: number, -- 0 ground, 1 deck, 2 flyover, -1 channel
	elevated: boolean, -- needs a deck + supports (any part above grade + 6)
	bridge: boolean, -- spans water or the Rust River
	corridor: string?, -- freeway carriageways sharing one deck
	district: string,
	traffic: boolean,
	way: number, -- source way id (stable within a VERSION)
}

local Nodes: { Node } = {}
local Edges: { Edge } = {}

for i, n in gnodes do
	Nodes[i] = { id = i, pos = Vector3.new(n.x, n.y, n.z), edges = {}, intersection = nil }
end

local function overWaterOrChannel(x: number, z: number): boolean
	local sd = shore(x, z)
	if sd < 0 then
		return true
	end
	local ch = WorldLayout.Channel
	local d = WorldGen.polyProject(ch.points, x, z)
	local _, cz = WorldGen.polyAt(ch.points, select(2, WorldGen.polyProject(ch.points, x, z)))
	return d < ch.floorHalfWidth + ch.wallRun and cz > ch.startOpenAt
end

for i, e in gedges do
	local w = ways[e.way]
	local pts: { Vector3 } = {}
	local maxAbove = 0
	local bridge = false
	for k, p in e.pts do
		table.insert(pts, Vector3.new(p.x, p.y, p.z))
		maxAbove = math.max(maxAbove, p.y - gradeAt(p.x, p.z))
		if w.layer >= 0 and w.class ~= "pier" then
			if overWaterOrChannel(p.x, p.z) then
				bridge = true
			end
			if k > 1 then
				local q = e.pts[k - 1]
				local mx, mz = (p.x + q.x) / 2, (p.z + q.z) / 2
				if overWaterOrChannel(mx, mz) then
					bridge = true
				end
			end
		end
	end
	local mid = e.pts[math.max(1, #e.pts // 2)]
	local midX, midZ = WorldGen.polyAt(e.pts, e.length / 2)
	local _ = mid
	local edge: Edge = {
		id = i,
		a = e.a,
		b = e.b,
		points = pts,
		length = e.length,
		class = w.class,
		name = w.name,
		oneWay = w.oneWay,
		lanesF = w.lanes,
		lanesB = if w.oneWay then 0 else w.lanes,
		laneWidth = LANE,
		median = w.median,
		parking = w.parking,
		width = wayWidth(w),
		sidewalk = w.sidewalk,
		shoulder = w.shoulder,
		speed = w.speed,
		layer = w.layer,
		elevated = maxAbove > 6 or w.class == "freeway",
		bridge = bridge,
		corridor = w.corridor,
		district = w.district or districtAt(midX, midZ),
		traffic = w.traffic,
		way = w.id,
	}
	Edges[i] = edge
	table.insert(Nodes[e.a].edges, i)
	if e.b ~= e.a then
		table.insert(Nodes[e.b].edges, i)
	end
end

WorldLayout.Nodes = Nodes
WorldLayout.Edges = Edges

-------------------------------------------------------------------------------------------------------------------------
-- 8. Intersections + traffic control
-------------------------------------------------------------------------------------------------------------------------

export type Approach = {
	edge: number,
	inbound: boolean, -- traffic can arrive at the node along this edge
	outbound: boolean, -- traffic can leave the node along this edge
	heading: Vector3, -- unit, pointing away from the node along the edge
	class: RoadClass,
	name: string,
}

export type Phase = { approaches: { number }, green: number }

export type Intersection = {
	id: number,
	node: number,
	pos: Vector3,
	control: "signal" | "stop" | "allway" | "yield" | "merge" | "none",
	radius: number, -- clear box: no parking, lots or props inside this radius
	approaches: { Approach },
	phases: { Phase }, -- signals only: approach indices that get green together
	cycle: number,
	amber: number,
	allRed: number,
	offset: number, -- green-wave offset (seconds) along the main road
	district: string,
}

local MAJOR: { [string]: boolean } = { boulevard = true, avenue = true, highway = true }
local URBAN: { [string]: boolean } = { downtown = true, midtown = true, beach = true, foundry = true, port = true, airport = true }

local Intersections: { Intersection } = {}

local function edgeHeadingFrom(e: Edge, node: number): Vector3
	local pts = e.points
	local p0, p1
	if e.a == node then
		p0 = pts[1]
		p1 = pts[math.min(#pts, 2)]
		-- look a little further along for a stable heading
		for k = 2, #pts do
			if (pts[k] - p0).Magnitude > 20 then
				p1 = pts[k]
				break
			end
		end
	else
		p0 = pts[#pts]
		p1 = pts[math.max(1, #pts - 1)]
		for k = #pts - 1, 1, -1 do
			if (pts[k] - p0).Magnitude > 20 then
				p1 = pts[k]
				break
			end
		end
	end
	local d = Vector3.new(p1.X - p0.X, 0, p1.Z - p0.Z)
	return if d.Magnitude > 1e-6 then d.Unit else Vector3.new(1, 0, 0)
end

for _, node in Nodes do
	local list = node.edges
	if #list < 3 then
		continue
	end
	local approaches: { Approach } = {}
	local hasRamp, hasFreeway, ground = false, false, true
	local maxHalf = 0
	for _, ei in list do
		local e = Edges[ei]
		local inbound = (not e.oneWay) or e.b == node.id
		local outbound = (not e.oneWay) or e.a == node.id
		table.insert(approaches, {
			edge = ei,
			inbound = inbound,
			outbound = outbound,
			heading = edgeHeadingFrom(e, node.id),
			class = e.class,
			name = e.name,
		})
		if e.class == "ramp" then
			hasRamp = true
		end
		if e.class == "freeway" then
			hasFreeway = true
		end
		if e.layer ~= 0 then
			ground = false
		end
		maxHalf = math.max(maxHalf, e.width / 2 + e.sidewalk)
	end
	local district = districtAt(node.pos.X, node.pos.Z)
	local control: "signal" | "stop" | "allway" | "yield" | "merge" | "none" = "stop"
	local majors = 0
	local classes: { [string]: boolean } = {}
	for _, a in approaches do
		if MAJOR[a.class] then
			majors += 1
		end
		classes[a.class] = true
	end
	if hasFreeway or (not ground and hasRamp) then
		control = "merge"
	elseif classes.pier or classes.channel or classes.runway or classes.service then
		control = "yield"
	elseif hasRamp then
		control = "signal"
	elseif majors >= 2 then
		control = "signal"
	elseif majors == 1 then
		control = if URBAN[district] then "signal" else "stop"
	else
		if district == "downtown" or district == "midtown" then
			control = if #approaches >= 4 then "signal" else "stop"
		elseif district == "southgate" or district == "cactus" or district == "beach" then
			control = "allway"
		else
			control = "stop"
		end
	end
	-- signal phases: pair opposite approaches; the busier pair first
	local phases: { Phase } = {}
	if control == "signal" then
		local assigned = table.create(#approaches, false)
		local function rank(a: Approach): number
			return if MAJOR[a.class] then 2 elseif a.class == "ramp" then 1 else 0
		end
		local idx = {}
		for k = 1, #approaches do
			table.insert(idx, k)
		end
		table.sort(idx, function(p: number, q: number): boolean
			local rp, rq = rank(approaches[p]), rank(approaches[q])
			if rp ~= rq then
				return rp > rq
			end
			return p < q
		end)
		for _, k in idx do
			if not assigned[k] then
				assigned[k] = true
				local group = { k }
				local best, bestDot = 0, -0.6
				for j = 1, #approaches do
					if not assigned[j] then
						local d = approaches[k].heading:Dot(approaches[j].heading)
						if d < bestDot then
							best, bestDot = j, d
						end
					end
				end
				if best > 0 then
					assigned[best] = true
					table.insert(group, best)
				end
				local major = rank(approaches[k]) >= 2
				table.insert(phases, { approaches = group, green = if major then 24 else 16 })
			end
		end
	end
	local cycle = 0
	for _, ph in phases do
		cycle += ph.green + 3 + 1.5
	end
	local inter: Intersection = {
		id = #Intersections + 1,
		node = node.id,
		pos = node.pos,
		control = control,
		radius = maxHalf,
		approaches = approaches,
		phases = phases,
		cycle = cycle,
		amber = 3,
		allRed = 1.5,
		-- green wave: progression at 58 studs/s along the east-west axis
		offset = if cycle > 0 then (node.pos.X / 58) % cycle else 0,
		district = district,
	}
	table.insert(Intersections, inter)
	node.intersection = inter.id
end

WorldLayout.Intersections = Intersections

-------------------------------------------------------------------------------------------------------------------------
-- 9. Spatial helpers used by the rest of the generator (edge index, frontage snapping)
-------------------------------------------------------------------------------------------------------------------------

local edgePts: { { pts: { P3 } } } = {}
for i, e in Edges do
	local pts: { P3 } = {}
	for _, p in e.points do
		table.insert(pts, { x = p.X, y = p.Y, z = p.Z })
	end
	edgePts[i] = { pts = pts }
end
local edgeIndex = WorldGen.edgeIndex(edgePts, 128, function(i: number): number
	return Edges[i].width / 2 + Edges[i].sidewalk + 4
end)

-- Footprint of a road edge (curb + sidewalk) at (x, z)?
local function roadClearance(x: number, z: number, extra: number): (boolean, number?)
	local found = false
	local hit: number? = nil
	local cell = edgeIndex.cell
	local cx, cz = math.floor(x / cell), math.floor(z / cell)
	for dx = -1, 1 do
		for dz = -1, 1 do
			local list = edgeIndex.cells[WorldGen.cellKey(cx + dx, cz + dz)]
			if list then
				for _, ei in list do
					local e = Edges[ei]
					local d = WorldGen.polyProject(edgePts[ei].pts, x, z)
					local reach = e.width / 2 + e.sidewalk + extra
					if d < reach then
						found = true
						hit = ei
						break
					end
				end
			end
			if found then
				break
			end
		end
		if found then
			break
		end
	end
	return found, hit
end

local function nodeRadius(nodeId: number): number
	local n = Nodes[nodeId]
	if n.intersection then
		return Intersections[n.intersection].radius
	end
	return 0
end

