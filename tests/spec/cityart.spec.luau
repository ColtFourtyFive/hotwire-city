--!nocheck
-- Config/CityArt (generated by tools/cityart/gen_config.py): every entry points at an uploaded rbxassetid, uses a
-- valid aspect for its kind, matches the PNG actually uploaded (manifest + IHDR size), references real brands and
-- districts, and every branded WorldLayout POI finds its own storefront sign. Also a denylist so no real-world /
-- Rockstar names or 18+ themes (alcohol, gambling, smoking) sneak into names or ad copy.
return function(t)
	local H = t.H
	local fs = require("@lune/fs")
	local serde = require("@lune/serde")
	local CityArt = H.require("src/shared/Config/CityArt")

	local manifest = serde.decode("json", fs.readFile("assets/cityart/manifest.json"))

	local function isAsset(s)
		return type(s) == "string" and string.match(s, "^rbxassetid://%d+$") ~= nil
	end

	-- every { list, required aspects? } with an image field
	local function allImages()
		local out = {}
		for key, b in CityArt.brands do
			table.insert(out, { id = "logo_" .. key, image = b.logo, aspect = "1:1" })
		end
		for _, list in { CityArt.billboards, CityArt.signs, CityArt.posters, CityArt.graffiti, CityArt.loading } do
			for _, e in list do
				table.insert(out, e)
			end
		end
		return out
	end

	local function pngSize(path)
		local data = fs.readFile(path)
		t.eq(string.sub(data, 2, 4), "PNG", path .. " is a PNG")
		return string.unpack(">I4", data, 17), string.unpack(">I4", data, 21)
	end

	t.test("counts per category", function()
		local brands = 0
		for _ in CityArt.brands do
			brands += 1
		end
		t.ok(brands >= 16 and brands <= 24, "16-24 brands, got " .. brands)
		t.ok(#CityArt.billboards >= 24 and #CityArt.billboards <= 32, "24-32 billboards")
		t.ok(#CityArt.signs >= 30, "30+ signs")
		t.ok(#CityArt.posters >= 8, "posters/flyers/bus ads")
		t.ok(#CityArt.graffiti >= 6, "graffiti")
		t.ok(#CityArt.loading >= 2 and #CityArt.loading <= 3, "2-3 loading pieces")
	end)

	t.test("every entry has an rbxassetid and a valid aspect", function()
		local ids, assets = {}, {}
		for _, e in allImages() do
			t.ok(type(e.id) == "string" and e.id ~= "", "id")
			t.ok(not ids[e.id], "duplicate id " .. e.id)
			ids[e.id] = true
			t.ok(isAsset(e.image), e.id .. " image is rbxassetid://<n>: " .. tostring(e.image))
			t.ok(not assets[e.image], e.id .. " reuses " .. tostring(assets[e.image]) .. "'s asset")
			assets[e.image] = e.id
			t.ok(CityArt.ASPECTS[e.aspect] ~= nil, e.id .. " aspect " .. tostring(e.aspect))
			t.ok(CityArt.PIXELS[e.aspect] ~= nil, e.id .. " pixels for aspect")
		end
	end)

	t.test("aspect fits the kind", function()
		for _, b in CityArt.billboards do
			t.ok(b.aspect == "2:1" or b.aspect == "1:2", b.id .. " billboard is wide 2:1 or portrait 1:2")
			t.ok(type(b.copy) == "string" and #b.copy > 0, b.id .. " copy")
		end
		local signAspect = { fascia = "8:3", awning = "2:1", painted = "2:1", pylon = "1:2" }
		for _, s in CityArt.signs do
			t.eq(s.aspect, signAspect[s.kind], s.id .. " " .. tostring(s.kind))
			t.ok(type(s.name) == "string" and #s.name > 0, s.id .. " name")
			t.ok(type(s.key) == "string" and #s.key > 0, s.id .. " key")
		end
		for _, p in CityArt.posters do
			t.eq(p.aspect, "2:3", p.id)
			t.ok(p.kind == "flyer" or p.kind == "poster" or p.kind == "busstop", p.id .. " kind")
		end
		for _, g in CityArt.graffiti do
			t.ok(g.kind == "tag" or g.kind == "stencil" or g.kind == "mural", g.id .. " kind")
			t.eq(g.alpha, g.kind ~= "mural", g.id .. " alpha (tags/stencils are decals, murals opaque)")
		end
		for _, l in CityArt.loading do
			t.eq(l.aspect, "16:9", l.id)
		end
		for key, ratio in CityArt.ASPECTS do
			local px = CityArt.PIXELS[key]
			t.near(px[1] / px[2], ratio, 0.01, key .. " pixel ratio")
			t.ok(px[1] <= 1024 and px[2] <= 1024, key .. " <= 1024 px")
		end
	end)

	t.test("config matches the uploaded files (manifest ids + PNG sizes)", function()
		for _, e in allImages() do
			local m = manifest[e.id]
			t.ok(m ~= nil, e.id .. " in manifest")
			t.eq(e.image, "rbxassetid://" .. string.format("%d", m.assetId), e.id .. " asset id")
			local w, h = pngSize(m.file)
			local px = CityArt.PIXELS[e.aspect]
			t.eq(w, px[1], e.id .. " width")
			t.eq(h, px[2], e.id .. " height")
		end
	end)

	t.test("brands: names, colors, references", function()
		for key, b in CityArt.brands do
			t.ok(type(b.name) == "string" and #b.name > 0, key .. " name")
			t.ok(type(b.category) == "string" and #b.category > 0, key .. " category")
			t.ok(#b.colors >= 1, key .. " colors")
			for _, c in b.colors do
				t.eq(typeof(c), "Color3", key .. " color type")
			end
		end
		for _, list in { CityArt.billboards, CityArt.signs, CityArt.posters } do
			for _, e in list do
				if e.brand ~= nil then
					t.ok(CityArt.brands[e.brand] ~= nil, e.id .. " brand " .. e.brand)
				end
			end
		end
		-- the categories the brief asks for are all covered
		local cats = {}
		for _, b in CityArt.brands do
			cats[b.category] = true
		end
		for _, c in
			{
				"fast_food",
				"coffee",
				"cola",
				"energy_drink",
				"gas",
				"bank",
				"phone_carrier",
				"car_maker",
				"fashion",
				"gym",
				"pharmacy",
				"radio",
				"convenience",
				"rental",
				"tech",
			}
		do
			t.ok(cats[c], "brand category " .. c)
		end
	end)

	t.test("radio brands match Config/Sounds stations", function()
		local Sounds = H.require("src/shared/Config/Sounds")
		local stations = {}
		for _, def in Sounds do
			if type(def) == "table" and def.station then
				stations[def.station] = true
			end
		end
		for key, b in CityArt.brands do
			if b.category == "radio" then
				t.ok(b.station and stations[b.station], key .. " station " .. tostring(b.station))
			end
		end
	end)

	t.test("districts are WorldLayout ids; branded POIs find their sign", function()
		local W = H.require("src/shared/Config/WorldLayout")
		local valid = {}
		for _, d in W.Districts do
			valid[d.id] = true
		end
		local function check(id, list)
			for _, d in list or {} do
				t.ok(valid[d], id .. " district " .. d)
			end
		end
		for key, b in CityArt.brands do
			check(key, b.districts)
		end
		for _, list in { CityArt.signs, CityArt.posters, CityArt.graffiti } do
			for _, e in list do
				check(e.id, e.districts)
			end
		end
		local branded = 0
		for _, poi in W.POIs do
			if poi.brand ~= nil then
				branded += 1
				local s = CityArt.signForPoi(poi)
				t.ok(s ~= nil, poi.name .. " (" .. poi.brand .. ") has a sign")
			end
		end
		t.ok(branded > 0, "WorldLayout has branded POIs")
		for name, want in
			{
				["Rusty's Chop Shop"] = "sign_rustys_chop",
				["Hotwire Motors"] = "sign_hotwire_motors",
				["Pinnacle Reserve Bank"] = "sign_pinnacle_reserve",
				["Sleepy Cactus Motel"] = "pylon_sleepy_cactus",
			}
		do
			local s = CityArt.signForPoi({ name = name })
			t.eq(s and s.id, want, name)
		end
		t.eq(CityArt.signForPoi({ name = "QuikStop 24 Southgate", brand = "QuikStop 24" }).id, "sign_quikstop")
		t.eq(CityArt.signForPoi({ name = "Nowhere In Particular" }), nil, "unknown POI")
	end)

	t.test("lookups are deterministic", function()
		t.eq(#CityArt.billboardsOf("2:1") + #CityArt.billboardsOf("1:2"), #CityArt.billboards)
		for _, s in CityArt.signsFor("cactus") do
			t.ok(#s.districts == 0 or table.find(s.districts, "cactus"), s.id)
		end
		t.ok(#CityArt.signsFor("beach", "awning") >= 2, "beach awnings")
		local wide = CityArt.billboardsOf("2:1")
		t.eq(CityArt.pick(wide, 12345), CityArt.pick(wide, 12345))
		t.eq(CityArt.pick({}, 3), nil)
		t.eq(CityArt.pick(wide, -7), wide[(7 % #wide) + 1])
	end)

	t.test("no real/Rockstar names or 18+ themes in names and copy", function()
		local banned = {
			"rockstar",
			"grand theft",
			"los santos",
			"vinewood",
			"vice city",
			"beer",
			"liquor",
			"vodka",
			"whiskey",
			"wine",
			"casino",
			"lottery",
			"poker",
			"cigar",
			"tobacco",
			"vape",
		}
		local texts = {}
		for _, b in CityArt.brands do
			table.insert(texts, b.name)
			table.insert(texts, b.tagline)
		end
		for _, list in { CityArt.billboards, CityArt.signs, CityArt.posters, CityArt.loading } do
			for _, e in list do
				table.insert(texts, e.copy or e.name or e.title or "")
			end
		end
		for _, s in texts do
			local low = string.lower(s)
			for _, w in banned do
				t.ok(string.find(low, w, 1, true) == nil, ("%q contains %q"):format(s, w))
			end
		end
	end)
end
